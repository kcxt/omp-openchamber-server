#!/usr/bin/env bun
// Offline stand-in for `omp --mode rpc`, for the sidecar's end-to-end tests.
//
// It speaks the same stdio JSONL protocol as omp (docs/rpc.md in oh-my-pi) and
// persists sessions the way omp does, so the sidecar's on-disk readers and its
// RPC driving are exercised for real:
//   - sessions live in `$PI_CODING_AGENT_DIR/sessions/<encoded cwd>/<ts>_<id>.jsonl`
//     (default `~/.omp/agent`), with omp's directory encoding, a 256-byte title
//     slot, a `type:"session"` header and `id`/`parentId` entry trees;
//   - a process owns a session through a lease; a writer that finds the lease held
//     by another live process moves to a sibling file (new id, `parentSession`
//     pointing back) instead of writing the owner's file (docs/session.md);
//   - `navigate_tree`, `fork`, `branch`, `get_entries` and `/move` work on that tree;
//   - runs follow omp's activity-stretch model (docs/omp-protocol.md §4): steers and follow-ups join the
//     live run, `abort` strands queued input, `session_settled` closes the stretch. test/contract/ asserts
//     every behaviour here against the real omp.
//   - the local branch's patches (docs/omp-protocol.md §11): `hostMessageId` on prompts (P1), `append_custom_entry` (P2),
//     `switch_session{claimLease}` (P3), `get_state.idleMaintenance` + the `recap` frame (P4, OMP_STUB_RECAP_MS),
//     `resume` (P5), and the one-shot CLI `omp session inspect|lease --json`, `omp models --json` (P6).
//
// No network, no credentials: replies come from a script.
//
//   OMP_STUB_SCRIPT  JSON file, re-read on every prompt:
//                    {"turns":[{"when":"<substring of the prompt>","steps":[...]}]}
//                    The first turn whose `when` is contained in the prompt (or
//                    has none) runs; with no match the stub echoes the prompt.
//                    Steps: {"text"} ("{{users}}" expands to the number of user
//                    messages in omp's current context) {"thinking"} {"sleep":ms} {"hang":true}
//                    {"goalComplete":true} (the agent calls the goal tool; omp keeps running goal turns "(#n)" while a goal is active)
//                    {"fail":"message"} {"crash":true} (process dies mid-turn) {"tool":"bash","args":{},"result":"text",
//                    "isError":bool,"details":{}}; a bash call with args.async=true returns at once and wakes the
//                    session after "asyncMs" (default 300) like a background job; {"tool":"task","args":{"name","task",
//                    "solutionSpace"},"subagent":{"steps":[...]}} spawns a detached subagent (lifecycle/progress/event
//                    frames per set_subagent_subscription; steps as here, {"hang":true} until cancel_subagent)
//   OMP_STUB_RECORD  file that receives every inbound frame (JSONL)
//   OMP_STUB_TICK_MS pause between streamed chunks (default 4)
//   OMP_STUB_START_DELAY_MS  time before the first command is handled, like a slow-booting omp (default 0)
//   OMP_STUB_RECAP_MS  idle recap delay (P4): this long after a stretch settles with a generated reply, `get_state.idleMaintenance`
//                    reports `recapDueAt` and a `recap` frame follows. Default off (omp's own default is 240 s).
//   OMP_STUB_NO_MODELS  1 = no models are available (only `omp session inspect` / `omp models` use it in practice)
//   OMP_STUB_PROVIDER  provider id of the stub's models (default "stub")
//   --auto-title      like omp's flag of the same name: the session names itself. Once the first assistant message of a session
//                    without a title is written, after the script's top-level `"titleDelayMs"` (default 40 ms) the stub writes
//                    a title into the transcript's title slot and emits `session_info_update {title, sessionId}`, as the
//                    patched omp does. The title is the script's top-level `"title"` string, else the first six words of the
//                    first user message. Without the flag (omp's RPC mode default) a session is never titled.
import { appendFileSync, existsSync, mkdirSync, readFileSync, readdirSync, realpathSync, renameSync, statSync, unlinkSync, writeFileSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { basename, dirname, isAbsolute, join, relative, resolve } from "node:path";
import { randomUUID } from "node:crypto";

const VERSION = "18.2.8";
if (process.argv.includes("--version")) {
  console.log(`omp/${VERSION}`);
  process.exit(0);
}

const argv = process.argv.slice(2);
const flag = (name: string) => {
  const i = argv.indexOf(name);
  return i >= 0 ? argv[i + 1] : undefined;
};
const cwd = resolve(flag("--cwd") ?? process.cwd());
const agentDir = process.env.PI_CODING_AGENT_DIR ?? join(homedir(), ".omp", "agent");
const sessionsRoot = join(agentDir, "sessions");
const leaseDir = process.env.PI_TEST_SESSION_OWNERS_DIR ?? join(dirname(agentDir), "run", "session-owners");
const TICK = Number(process.env.OMP_STUB_TICK_MS ?? 4);
const PROVIDER = process.env.OMP_STUB_PROVIDER ?? "stub";
const NO_MODELS = process.env.OMP_STUB_NO_MODELS === "1";
const AUTO_TITLE = argv.includes("--auto-title");
const RECAP_MS = Number(process.env.OMP_STUB_RECAP_MS ?? 0);
const MODELS = NO_MODELS ? [] : [
  { provider: PROVIDER, id: "fast", name: "Stub Fast", reasoning: false },
  { provider: PROVIDER, id: "smart", name: "Stub Smart", reasoning: true },
];

// ---------------------------------------------------------------- directory layout
function realpath(p: string): string {
  try { return realpathSync(p); } catch { return resolve(p); }
}
function within(rel: string): boolean {
  return rel !== ".." && !rel.startsWith(`..${"/"}`) && !isAbsolute(rel);
}
function encodeRel(prefix: string, rel: string): string {
  const enc = rel.replace(/[/\\:]/g, "-");
  return enc ? (prefix.endsWith("-") ? `${prefix}${enc}` : `${prefix}-${enc}`) : prefix;
}
/** omp's bucket name for a cwd: `-<rel>` under home, `-tmp-<rel>` under tmp, else `--<abs>--`. */
function sessionDirName(dir: string): string {
  const canon = realpath(dir);
  const homeRel = relative(realpath(homedir()), canon);
  const tmpRel = relative(realpath(tmpdir()), canon);
  if (within(tmpRel)) return encodeRel("-tmp", tmpRel);
  if (within(homeRel)) return encodeRel("-", homeRel);
  return `--${canon.replace(/^[/\\]/, "").replace(/[/\\:]/g, "-")}--`;
}

// ---------------------------------------------------------------- leases
const leasePath = (id: string) => join(leaseDir, id);
function alive(pid: number): boolean {
  try { process.kill(pid, 0); return true; } catch { return false; }
}
function leaseHeldByOther(id: string): boolean {
  try {
    const pid = Number(readFileSync(leasePath(id), "utf8"));
    return Number.isFinite(pid) && pid !== process.pid && alive(pid);
  } catch { return false; }
}
const owned = new Set<string>();
function claim(id: string): void {
  mkdirSync(leaseDir, { recursive: true });
  writeFileSync(leasePath(id), String(process.pid));
  owned.add(id);
}
/** Leaving a session (switch, new, fork) gives up its lease, as omp's session manager does when it closes. */
function releaseLease(id: string): void {
  if (!owned.delete(id)) return;
  try { if (readFileSync(leasePath(id), "utf8") === String(process.pid)) unlinkSync(leasePath(id)); } catch { /* gone */ }
}
function releaseAll(): void {
  for (const id of owned) {
    try { if (readFileSync(leasePath(id), "utf8") === String(process.pid)) unlinkSync(leasePath(id)); } catch { /* gone */ }
  }
  owned.clear();
}

// ---------------------------------------------------------------- session state
type Entry = Record<string, any> & { id: string; parentId: string | null; type: string };
type Header = Record<string, any> & { id: string; cwd: string };

const hex8 = () => randomUUID().slice(0, 8);
const now = () => new Date().toISOString();

let header: Header = { type: "session", version: 3, id: randomUUID(), timestamp: now(), cwd };
let file: string | null = null; // set once the session is first written
let entries: Entry[] = [];
let leaf: string | null = null;
let model = MODELS[0]!;
let thinking = "off";
let todoPhases: any[] = [];
let claimed = false;
// omp's goal mode: the agent completes it with the `goal` tool; while it is active omp keeps
// running continuation turns by itself (goal.continuationModes includes "rpc").
let goal: { id: string; objective: string; status: string; tokenBudget?: number; tokensUsed: number } | null = null;
let goalScheduled = false;
let goalSuppressed = false;
let lastTurnWasContinuation = false;
let goalTurns = 0;
// P4: idle recap armed after a settled stretch whose last message was generated (OMP_STUB_RECAP_MS)
let recapPending = false;
let recapDueAt: number | undefined;
let recapTimer: ReturnType<typeof setTimeout> | undefined;
const GOAL_CONTINUATION = "The session goal is still open. Take it through to the end in this run.";
// Every goal change is journalled like omp's goal runtime does: a `mode_change` carrying the goal.
const goalEvent = () => {
  if (goal?.status === "active" || goal?.status === "paused") append("mode_change", { mode: goal.status === "active" ? "goal" : "goal_paused", data: { goal } });
  out({ type: "goal_updated", goal, state: goal ? { enabled: goal.status === "active", mode: "active", goal } : undefined });
};
function scheduleGoalContinuation(): void {
  if (goalScheduled || goalSuppressed || busy || aborted || asyncJobs > 0 || goal?.status !== "active") return; // omp holds a continuation back while background work runs
  goalScheduled = true;
  stretchActive = true; // a reported pending goal turn opens a stretch that still ends with session_settled
  setTimeout(() => {
    goalScheduled = false;
    if (!busy && goal?.status === "active" && !goalSuppressed) void runAgent(undefined, `${GOAL_CONTINUATION} (#${++goalTurns})`);
    else settleCheck();
  }, 30);
}

function titleSlot(title = ""): string {
  const base = { type: "title", v: 1, title, updatedAt: now(), pad: "" };
  const used = Buffer.byteLength(JSON.stringify(base)) + 1;
  return JSON.stringify({ ...base, pad: " ".repeat(Math.max(0, 256 - used)) }) + "\n";
}
function newFilePath(h: Header): string {
  return join(sessionsRoot, sessionDirName(h.cwd), `${h.timestamp.replace(/[:.]/g, "-")}_${h.id}.jsonl`);
}
function writeWhole(path: string): void {
  mkdirSync(dirname(path), { recursive: true });
  const body = [JSON.stringify(header), ...entries.map((e) => JSON.stringify(e))].join("\n") + "\n";
  writeFileSync(path, titleSlot(header.title) + body);
}

/** Take the session's lease; if another live process owns it, move to a sibling session. */
function ensureOwnership(): void {
  if (claimed) return;
  if (leaseHeldByOther(header.id)) {
    header = { ...header, id: randomUUID(), timestamp: now(), parentSession: header.id };
    file = null;
  }
  claim(header.id);
  claimed = true;
}
function persist(entry: Entry): void {
  // Like omp (session-manager.ts #shouldHaveSessionFile): a session that has produced no assistant
  // message has no file and holds no lease; entries stay in memory until the first one arrives.
  if (!file || !existsSync(file)) {
    if (!entries.some((e) => e.type === "message" && e.message?.role === "assistant")) return;
    ensureOwnership();
    file = file ?? newFilePath(header);
    writeWhole(file); // header + every entry so far (a moved session publishes its whole transcript)
    return;
  }
  ensureOwnership();
  appendFileSync(file, JSON.stringify(entry) + "\n");
}
function append(type: string, body: Record<string, any>): Entry {
  const entry: Entry = { type, id: hex8(), parentId: leaf, timestamp: now(), ...body };
  entries.push(entry);
  leaf = entry.id;
  persist(entry);
  return entry;
}

function parseSessionFile(path: string): { header: Header; entries: Entry[] } {
  let hdr: Header | undefined;
  const list: Entry[] = [];
  for (const line of readFileSync(path, "utf8").split("\n")) {
    if (!line.trim()) continue;
    let rec: any;
    try { rec = JSON.parse(line); } catch { continue; }
    if (rec.type === "session" && !hdr) hdr = rec;
    else if (rec.type === "title") hdr = hdr ? { ...hdr, title: rec.title || hdr.title } : hdr;
    else if (rec.type !== "session") list.push(rec); // id-less records stay in the list like omp's: they leave the leaf undefined
  }
  if (!hdr) throw new Error(`Not a session file: ${path}`);
  return { header: hdr, entries: list };
}
function load(path: string): void {
  const parsed = parseSessionFile(path);
  header = parsed.header;
  entries = parsed.entries;
  leaf = entries.length ? ((entries[entries.length - 1]!.id as string | undefined) ?? (undefined as unknown as null)) : null;
  file = path;
  claimed = false; // the lease is taken by the first write, not by opening
  // the session journal decides the model and effort: the latest model_change or assistant message, the latest thinking_level_change
  for (const e of [...entries].reverse()) {
    const spec = e.type === "model_change" ? String(e.model) : e.type === "message" && e.message?.role === "assistant" ? `${e.message.provider}/${e.message.model}` : undefined;
    const found = spec ? MODELS.find((m) => `${m.provider}/${m.id}` === spec) : undefined;
    if (found) { model = found; break; }
  }
  const lastThinking = [...entries].reverse().find((e) => e.type === "thinking_level_change");
  thinking = lastThinking?.thinkingLevel ?? "off";
  todoPhases = [];
}
function fresh(parentSession?: string): void {
  header = { type: "session", version: 3, id: randomUUID(), timestamp: now(), cwd, ...(parentSession ? { parentSession } : {}) };
  entries = []; leaf = null; file = null; claimed = false; todoPhases = [];
}
function pathTo(id: string | null): Entry[] {
  const byId = new Map(entries.map((e) => [e.id, e]));
  const out: Entry[] = [];
  for (let e = id ? byId.get(id) : undefined; e; e = e.parentId ? byId.get(e.parentId) : undefined) out.unshift(e);
  return out;
}
const branch = () => pathTo(leaf);
const messages = () => branch().filter((e) => e.type === "message").map((e) => e.message);

// ---------------------------------------------------------------- protocol output
function out(frame: Record<string, unknown>): void {
  process.stdout.write(JSON.stringify(frame) + "\n");
}
function respond(id: string | undefined, command: string, data?: unknown): void {
  out({ ...(id ? { id } : {}), type: "response", command, success: true, ...(data !== undefined ? { data } : {}) });
}
function fail(id: string | undefined, command: string, error: string, code?: string): void {
  out({ ...(id ? { id } : {}), type: "response", command, success: false, error, ...(code ? { code } : {}) });
}
const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

// ---------------------------------------------------------------- turns
// Mirrors omp's RPC activity model (modes/rpc/rpc-session-settle.ts, rpc-prompt-results.ts):
//   - one `agent_start` … `agent_end` run absorbs steers and follow-ups queued while it streams;
//   - a prompt accepted into a live run reports `prompt_result` at the first yield with the queue drained;
//   - `session_settled` closes the stretch once nothing is live, queued, async or scheduled;
//   - a queued message stranded by a plain `abort` keeps the stretch open (omp does the same).
let busy = false; // a run is live
let aborted = false;
let wake: (() => void) | undefined;
let stretchActive = false; // agent activity since the last session_settled
let runCount = 0;
let messageSeq = 0;
let asyncJobs = 0; // background bash jobs and detached subagents
let subLevel = "off";
type Ticket = { id?: string; queued: boolean; run?: number };
type QueueItem = { text: string; ticket?: Ticket; custom?: { customType: string; content: string }; hostMessageId?: string };
const steering: QueueItem[] = [];
const followUps: QueueItem[] = [];
const tickets = new Set<Ticket>();
const abortWaiters: Array<() => void> = [];
const queueSize = () => steering.length + followUps.length;
const isSettled = () => !busy && queueSize() === 0 && asyncJobs === 0 && !goalScheduled;
const queueUpdate = () => out({ type: "queue_update", steering: steering.map((q) => q.text), followUp: followUps.map((q) => q.text), liveSteered: 0 });
function openTicket(id: string | undefined, queued: boolean): Ticket {
  const t: Ticket = { id, queued };
  tickets.add(t);
  return t;
}

async function pause(ms: number): Promise<void> {
  if (aborted) return;
  await Promise.race([sleep(ms), new Promise<void>((r) => { wake = r; })]);
  wake = undefined;
}

function pickSteps(prompt: string): any[] {
  let script: { turns?: Array<{ when?: string; steps: any[] }> } = {};
  const path = process.env.OMP_STUB_SCRIPT;
  if (path && existsSync(path)) {
    try { script = JSON.parse(readFileSync(path, "utf8")); } catch { /* fall through to echo */ }
  }
  const turn = script.turns?.find((t) => !t.when || prompt.includes(t.when));
  return turn?.steps ?? [{ text: `Echo: ${prompt}` }];
}

// --auto-title: the user message that will name the session, and the timer that writes the title.
let titleInput: string | undefined;
let titleTimer: ReturnType<typeof setTimeout> | undefined;
function noteTitleInput(text: string): void {
  if (AUTO_TITLE && !header.title && titleInput === undefined && text.trim()) titleInput = text;
}
function setTitle(title: string): void {
  header = { ...header, title };
  if (file) writeFileSync(file, titleSlot(title) + readFileSync(file, "utf8").split("\n").slice(1).join("\n"));
  // As the patched omp: every title change, generated or set, is announced.
  out({ type: "session_info_update", title, sessionId: header.id });
}
function armAutoTitle(): void {
  if (titleInput === undefined || titleTimer || header.title) return;
  const input = titleInput;
  let scripted: { title?: unknown; titleDelayMs?: unknown } = {};
  const path = process.env.OMP_STUB_SCRIPT;
  if (path && existsSync(path)) {
    try { scripted = JSON.parse(readFileSync(path, "utf8")); } catch { /* derived below */ }
  }
  titleTimer = setTimeout(() => {
    titleTimer = undefined;
    if (header.title) return;
    setTitle(typeof scripted.title === "string" && scripted.title.trim() ? scripted.title.trim() : input.trim().split(/\s+/).slice(0, 6).join(" "));
  }, typeof scripted.titleDelayMs === "number" ? scripted.titleDelayMs : 40);
}
function usage(outTokens: number) {
  return { input: 100, output: outTokens, cacheRead: 0, cacheWrite: 0, totalTokens: 100 + outTokens, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } };
}
function chunks(text: string): string[] {
  return text.match(/[\s\S]{1,6}/g) ?? [];
}
/** Steps become assistant messages: content steps, then the tool calls they make; the next group is the reply to the results. */
function groupSteps(steps: any[]): Array<{ content: any[]; tools: any[] }> {
  const groups: Array<{ content: any[]; tools: any[] }> = [];
  let cur = { content: [] as any[], tools: [] as any[] };
  for (const step of steps) {
    if (step.tool) cur.tools.push(step);
    else {
      if (cur.tools.length) { groups.push(cur); cur = { content: [], tools: [] }; }
      cur.content.push(step);
    }
  }
  if (cur.content.length || cur.tools.length) groups.push(cur);
  return groups;
}
/** Message lifecycle frames carry a `messageId` shared by start, updates and end (rpc-types.ts RpcMessageEventFrame). */
const newMessageId = () => `msg-${++messageSeq}`;

/** omp's recovery directive for `resume` (turn-recovery.ts manualContinuePrompt). */
const CONTINUE_TEXT = "<system-notice>\nContinue.\n\nMUST resume most recent intent; complete unfinished work.\nIf interrupted mid-step: resume where stopped.\nNEVER pause to summarize progress, re-confirm plan, or ask whether to proceed; continue.\n</system-notice>\n";
const developerMessage = (text: string) => ({ role: "developer", content: [{ type: "text", text }], attribution: "agent", timestamp: Date.now(), synthetic: true, userInitiated: true });

/** The prompt `resume` answers again instead of adding a directive: the last user prompt (or `.` directive) when only cut-off assistant turns follow it. */
function unansweredPrompt(): string | undefined {
  const list = messages();
  for (let i = list.length - 1; i >= 0; i--) {
    const m = list[i]!;
    if (m.role === "assistant") {
      const cutOff = (m.stopReason === "aborted" || m.stopReason === "error") && !m.content?.some((b: any) => (b.type === "text" && b.text) || b.type === "toolCall");
      if (!cutOff) return undefined;
    } else if (m.role === "user" || (m.role === "developer" && m.userInitiated === true)) {
      return String(m.content?.[0]?.text ?? "");
    }
  }
  return undefined;
}

/** A wake source (finished background job or subagent): joins the live run as a follow-up, or starts one. */
function wakeWith(custom: { customType: string; content: string }): void {
  if (busy) { followUps.push({ text: custom.content, custom }); queueUpdate(); }
  else void runAgent(undefined, custom.content, { custom });
}

function settleCheck(): void {
  if (!stretchActive || busy) return;
  if (goalScheduled) { goalScheduled = false; scheduleGoalContinuation(); return; }
  if (!isSettled()) return;
  stretchActive = false;
  out({ type: "session_settled" });
  armRecap();
}

// P4: omp arms its idle recap once the stretch has settled and the last message was generated; get_state reports the due time until it fires.
function cancelRecap(): void {
  clearTimeout(recapTimer);
  recapTimer = undefined;
  recapDueAt = undefined;
  recapPending = false;
}
function armRecap(): void {
  if (!(RECAP_MS > 0) || !recapPending || recapTimer) return;
  recapDueAt = Date.now() + RECAP_MS;
  recapTimer = setTimeout(() => {
    recapTimer = undefined;
    if (!isSettled()) { recapDueAt = undefined; return; } // a later settlement re-arms it
    recapPending = false;
    recapDueAt = undefined;
    out({ type: "recap", recap: `Stub recap: ${messages().length} messages in context.`, createdAt: Date.now() });
  }, RECAP_MS);
}

function reportTickets(runNo: number, outcome: { status: string; failure?: string }): void {
  const drained = queueSize() === 0;
  for (const t of [...tickets]) {
    if (t.queued ? !drained : t.run !== runNo) continue;
    tickets.delete(t);
    out({ type: "prompt_result", ...(t.id ? { id: t.id } : {}), agentInvoked: true, status: outcome.status, ...(outcome.failure ? { error: { message: outcome.failure, retryable: false } } : {}), sessionSettled: isSettled() });
  }
}

type FirstOpts = {
  steering?: boolean;
  custom?: QueueItem["custom"];
  hostMessageId?: string;
  /** `resume`'s continue directive: journaled as a synthetic developer message, not a user message. */
  synthetic?: boolean;
  /** `resume` of an unanswered prompt: the run answers the journaled prompt again and journals no message. */
  continueOnly?: boolean;
  /** Called right after `agent_start`, before the first turn. */
  onStart?: () => void;
};
async function runAgent(ticket: Ticket | undefined, text: string, first: FirstOpts = {}): Promise<void> {
  // Like omp's extension commands: a notify frame and no agent turn at all.
  if (!first.custom) {
    const local = (): void => {
      if (!ticket) return;
      tickets.delete(ticket);
      out({ type: "prompt_result", ...(ticket.id ? { id: ticket.id } : {}), agentInvoked: false, status: "completed", sessionSettled: isSettled() });
    };
    if (text.startsWith("/pi-vcc skip")) {
      out({ type: "manual_compaction_start" });
      out({ type: "manual_compaction_end", aborted: false, skipped: true, errorMessage: "Nothing to compact: the session is empty." });
      return local();
    }
    if (text.startsWith("/pi-vcc output")) {
      out({ type: "command_output", text: "Context: 40 of 100000 tokens used." });
      return local();
    }
    if (text.startsWith("/pi-vcc")) {
      out({ type: "extension_ui_request", id: hex8(), method: "notify", message: "Nothing to compact yet.", notifyType: "warning" });
      return local();
    }
  }
  const runNo = ++runCount;
  busy = true; aborted = false; stretchActive = true;
  cancelRecap();
  if (ticket) ticket.run = runNo;
  out({ type: "agent_start" });
  first.onStart?.();
  const newMessages: any[] = [];
  let turnOpen = false;
  let failure: string | undefined;

  const deliver = (body: string, opts: FirstOpts) => {
    out({ type: "turn_start" });
    turnOpen = true;
    const mid = newMessageId();
    if (!opts.custom && !opts.synthetic && !body.startsWith(GOAL_CONTINUATION)) noteTitleInput(body);
    if (opts.custom) {
      const message = { role: "custom", customType: opts.custom.customType, content: opts.custom.content, display: true, attribution: "agent", timestamp: Date.now() };
      out({ type: "message_start", message, messageId: mid });
      append("custom_message", { customType: opts.custom.customType, content: opts.custom.content, display: true });
      out({ type: "message_end", message, messageId: mid });
      newMessages.push(message);
      return;
    }
    const message = opts.synthetic
      ? developerMessage(body)
      : { role: "user", content: [{ type: "text", text: body }], ...(opts.steering ? { steering: true } : {}), attribution: "user", timestamp: Date.now(), ...(opts.hostMessageId ? { hostMessageId: opts.hostMessageId } : {}) };
    out({ type: "message_start", message, messageId: mid });
    append("message", { message });
    out({ type: "message_end", message, messageId: mid });
    newMessages.push(message);
  };

  const runGroup = async (group: { content: any[]; tools: any[] }): Promise<void> => {
    if (!turnOpen) out({ type: "turn_start" });
    turnOpen = false;
    const mid = newMessageId();
    const blocks: any[] = [];
    const partial = () => ({ role: "assistant", content: blocks.map((b) => ({ ...b })), api: "stub", provider: model.provider, model: model.id, usage: usage(0), stopReason: "stop", timestamp: Date.now() });
    out({ type: "message_start", message: partial(), messageId: mid });
    const event = (e: Record<string, unknown>) => out({ type: "message_update", message: partial(), messageId: mid, assistantMessageEvent: { ...e, partial: partial() } });

    for (const step of group.content) {
      if (aborted) break;
      if (step.crash) process.exit(7); // dies like a segfault/OOM kill: no frames, no cleanup
      if (step.fail) { failure = String(step.fail); break; }
      if (step.sleep) { await pause(step.sleep); continue; }
      if (step.goalComplete) {
        if (goal) { goal = { ...goal, status: "complete" }; goalEvent(); }
        continue;
      }
      if (step.hang) { while (!aborted) await pause(60_000); break; }
      const kind = step.thinking !== undefined ? "thinking" : "text";
      // `{{users}}` lets a script show how much context omp itself still holds.
      const full: string = String(step.thinking ?? step.text ?? "").replaceAll("{{users}}", String(messages().filter((m) => m.role === "user").length));
      const index = blocks.push(kind === "thinking" ? { type: "thinking", thinking: "" } : { type: "text", text: "" }) - 1;
      event({ type: `${kind}_start`, contentIndex: index });
      for (const piece of chunks(full)) {
        if (aborted) break;
        blocks[index][kind === "thinking" ? "thinking" : "text"] += piece;
        event({ type: `${kind}_delta`, contentIndex: index, delta: piece });
        await pause(TICK);
      }
      event({ type: `${kind}_end`, contentIndex: index, content: blocks[index][kind === "thinking" ? "thinking" : "text"] });
    }
    const calls: any[] = [];
    for (const step of group.tools) {
      if (aborted || failure) break;
      const call = { type: "toolCall", id: `call_${hex8()}`, name: step.tool, arguments: step.args ?? {} };
      const index = blocks.push({ ...call, arguments: {} }) - 1;
      event({ type: "toolcall_start", contentIndex: index });
      const json = JSON.stringify(call.arguments);
      for (const piece of chunks(json)) { event({ type: "toolcall_delta", contentIndex: index, delta: piece }); await pause(TICK); }
      blocks[index] = call;
      event({ type: "toolcall_end", contentIndex: index, toolCall: call });
      calls.push({ call, step });
    }

    const final = {
      role: "assistant", content: blocks, api: "stub", provider: model.provider, model: model.id,
      usage: usage(blocks.length * 10),
      contextSnapshot: { promptTokens: 100, nonMessageTokens: 40, toolSchemaTokens: 10 },
      stopReason: failure ? "error" : aborted ? "aborted" : calls.length ? "toolUse" : "stop",
      ...(failure ? { errorMessage: failure } : {}),
      ...(aborted ? { errorMessage: "Request was aborted" } : {}),
      timestamp: Date.now(),
    };
    append("message", { message: final });
    out({ type: "message_end", message: final, messageId: mid });
    newMessages.push(final);
    if (!failure && !aborted) armAutoTitle();

    const results: any[] = [];
    if (!final.stopReason.match(/error|aborted/)) {
      for (const { call, step } of calls) {
        out({ type: "tool_execution_start", toolCallId: call.id, toolName: call.name, args: call.arguments });
        if (step.sleep) await pause(step.sleep);
        let text = String(step.result ?? "ok");
        if (call.name === "bash" && call.arguments?.async === true) {
          // A background job: the call returns at once, the finished job wakes the session later.
          const job = `bg_${++asyncSeq}`;
          text = `Command running as background job ${job}.`;
          asyncJobs++;
          setTimeout(() => {
            asyncJobs--;
            wakeWith({ customType: "async-result", content: `<system-notice>\nBackground job ${job} (${String(call.arguments.command ?? "")}) has completed.\nResume your work using the result below.\n${String(step.result ?? "ok")}\n</system-notice>` });
          }, Number(step.asyncMs ?? 300));
        } else if (call.name === "task" && step.subagent) {
          // omp's task tool spawns a detached agent and returns at once; frames follow on the parent's stream.
          const name = String(call.arguments?.name ?? `Agent${subIndex + 1}`);
          text = `Spawned agent \`${name}\` (job \`${name}\`).`;
          asyncJobs++;
          setTimeout(() => { void runSubagent(call, step.subagent); }, 20);
        }
        out({ type: "tool_execution_update", toolCallId: call.id, toolName: call.name, args: call.arguments, partialResult: { content: [{ type: "text", text }] } });
        if (call.name === "todo" && step.details?.phases) todoPhases = step.details.phases;
        const result = { content: [{ type: "text", text }], ...(step.details ? { details: step.details } : {}) };
        out({ type: "tool_execution_end", toolCallId: call.id, toolName: call.name, result, isError: !!step.isError });
        const msg = { role: "toolResult", toolCallId: call.id, toolName: call.name, content: result.content, ...(step.details ? { details: step.details } : {}), isError: !!step.isError, timestamp: Date.now() };
        const rid = newMessageId();
        out({ type: "message_start", message: msg, messageId: rid });
        append("message", { message: msg });
        out({ type: "message_end", message: msg, messageId: rid });
        results.push(msg); newMessages.push(msg);
      }
    }
    out({ type: "turn_end", message: final, toolResults: results });
  };

  if (!first.continueOnly) deliver(text, first);
  let groups = groupSteps(pickSteps(text));
  let gi = 0;
  for (;;) {
    if (!aborted && !failure) {
      // Delivery point: steers go in at the next turn boundary, follow-ups once the model has nothing more to say.
      const fromSteer = steering.length > 0;
      const next = fromSteer ? steering.shift() : gi >= groups.length ? followUps.shift() : undefined;
      if (next) {
        queueUpdate();
        deliver(next.text, { steering: fromSteer, custom: next.custom, hostMessageId: next.hostMessageId });
        groups = groupSteps(pickSteps(next.text));
        gi = 0;
      }
    }
    if (gi >= groups.length || aborted || failure) break;
    await runGroup(groups[gi++]!);
  }

  const toolCalls = newMessages.filter((m) => m.role === "toolResult").length;
  if (lastTurnWasContinuation) goalSuppressed = toolCalls === 0; // no progress: omp stops continuing
  if (first.custom && goal) goalSuppressed = toolCalls === 0; // a background wake that made no progress ends the goal's run of turns too (contract/parent-idle)
  lastTurnWasContinuation = text.startsWith(GOAL_CONTINUATION);
  if (goal) goal = { ...goal, tokensUsed: goal.tokensUsed + 110 };
  if (aborted && goal?.status === "active") { goal = { ...goal, status: "paused" }; goalEvent(); }
  if (goal?.status === "complete") {
    const done = goal; goal = null;
    // Like omp's #journalCompletion: the mode ends, then the completion record.
    append("mode_change", { mode: "none" });
    append("custom", { customType: "goal-completed", data: { objective: done.objective, tokensUsed: done.tokensUsed, tokenBudget: done.tokenBudget } });
    out({ type: "goal_updated", goal: done, state: { enabled: false, mode: "exiting", reason: "completed", goal: done } });
  }
  else if (goal) goalEvent();
  if (goal?.status === "active" && !aborted && !goalSuppressed && asyncJobs === 0) goalScheduled = true; // pending before settlement is reported
  const outcome = { status: aborted ? "aborted" : failure ? "error" : "completed", failure };
  const lastMessage = newMessages.at(-1);
  recapPending = lastMessage?.role === "assistant" && lastMessage.content.length > 0;
  busy = false;
  out({ type: "agent_end", messages: newMessages, isTerminal: true, yielded: true });
  // abort / abort_and_prompt answer once the run has yielded
  const waiters = abortWaiters.splice(0);
  for (const w of waiters) w();
  // Like omp: prompt_result a macrotask after agent_end, session_settled after it.
  setImmediate(() => {
    reportTickets(runNo, outcome);
    setImmediate(settleCheck);
  });
}

// ---------------------------------------------------------------- subagents
// The task tool runs a subagent inside the parent process (task/executor.ts); the parent's
// stream carries `subagent_lifecycle`, `subagent_progress` and (at level "events") `subagent_event`.
let subIndex = 0;
let asyncSeq = 0;
const subagents = new Map<string, { snapshot: any; cancel: () => void; resume: (hostMessageId?: string) => void; steer: (message: string, hostMessageId?: string) => void }>();
const subagentModels = new Map<string, string>();
/** Finished subagents stay registered: `resume` revives them from their transcript, as omp's lifecycle manager does. */
const finishedSubagents = new Map<string, { call: any; sessionFile: string; index: number }>();
async function runSubagent(call: any, spec: { steps?: any[] }): Promise<void> {
  const args = call.arguments ?? {};
  const index = subIndex++;
  const id = String(args.name ?? `Agent${index + 1}`);
  const assignment = String(args.task ?? "");
  const task = `Complete assignment thoroughly:\n\n${assignment}`;
  const parentFile = file ?? newFilePath(header);
  const sessionFile = join(parentFile.replace(/\.jsonl$/, ""), `${id}.jsonl`);
  const subHeader = { type: "session", version: 3, id: randomUUID(), timestamp: now(), cwd };
  const subEntries: Entry[] = [];
  let subLeaf: string | null = null;
  const subJournal = (type: string, body: Record<string, any>) => {
    const entry: Entry = { type, id: hex8(), parentId: subLeaf, timestamp: now(), ...body };
    subLeaf = entry.id; subEntries.push(entry);
    mkdirSync(dirname(sessionFile), { recursive: true });
    writeFileSync(sessionFile, titleSlot() + [JSON.stringify(subHeader), ...subEntries.map((e) => JSON.stringify(e))].join("\n") + "\n");
  };
  const subAppend = (message: any) => subJournal("message", { message });
  const started = Date.now();
  let cancelled = false;
  let resumeReq: { hostMessageId?: string } | undefined; // P5: interrupt the running turn and continue with the recovery directive
  const interrupted = () => cancelled || resumeReq !== undefined;
  const nap = async (ms: number) => { const end = Date.now() + ms; while (Date.now() < end && !interrupted()) await sleep(Math.min(25, end - Date.now())); };
  let toolCount = 0;
  // Steers (steer_subagent) wait for the next turn boundary, as in omp; the subagent then reads them as its user.
  const steers: Array<{ message: string; hostMessageId?: string }> = [];
  const readSteers = () => {
    for (const { message, hostMessageId } of steers.splice(0)) {
      ev({ type: "turn_start" });
      const steered = { role: "user", content: [{ type: "text", text: message }], attribution: "user", timestamp: Date.now(), ...(hostMessageId ? { hostMessageId } : {}) };
      ev({ type: "message_start", message: steered }); subAppend(steered); ev({ type: "message_end", message: steered }); msgs.push(steered);
      const reply = { role: "assistant", content: [{ type: "text", text: "acknowledged" }], api: "stub", provider: model.provider, model: model.id, usage: usage(10), stopReason: "stop", timestamp: Date.now() };
      ev({ type: "message_start", message: { ...reply, content: [] } });
      ev({ type: "message_end", message: reply }); subAppend(reply); msgs.push(reply);
      ev({ type: "turn_end", message: reply, toolResults: [] });
    }
  };
  const progress: any = { index, id, agent: "task", agentSource: "bundled", status: "running", task, assignment, recentTools: [], recentOutput: [], toolCount: 0, requests: 0, tokens: 0, cost: 0, durationMs: 0 };
  const snapshot = () => ({ id, index, agent: "task", agentSource: "bundled", description: assignment, status: progress.status, task, assignment, sessionFile, lastUpdate: Date.now(), progress: { ...progress }, parentToolCallId: call.id });
  const lifecycle = (status: string) => { if (subLevel !== "off") out({ type: "subagent_lifecycle", payload: { id, agent: "task", parentToolCallId: call.id, detached: true, agentSource: "bundled", status, sessionFile, index } }); };
  const report = () => {
    progress.toolCount = toolCount; progress.durationMs = Date.now() - started;
    if (subLevel !== "off") out({ type: "subagent_progress", payload: { index, agent: "task", agentSource: "bundled", task, parentToolCallId: call.id, detached: true, assignment, progress: { ...progress }, sessionFile } });
  };
  const ev = (event: Record<string, unknown>) => { if (subLevel === "events") out({ type: "subagent_event", payload: { id, event } }); };
  subagents.set(id, {
    snapshot: snapshot(),
    cancel: () => { cancelled = true; },
    steer: (message, hostMessageId) => { steers.push({ message, hostMessageId }); },
    resume: (hostMessageId) => {
      resumeReq = { hostMessageId };
      if (hostMessageId) subJournal("custom", { customType: "host-resume", data: { hostMessageId, text: "." } });
    },
  });

  lifecycle("started");
  ev({ type: "agent_start" });
  report();
  const msgs: any[] = [];
  ev({ type: "turn_start" });
  const user = { role: "user", content: [{ type: "text", text: task }], attribution: "agent", timestamp: Date.now() };
  ev({ type: "message_start", message: user }); subAppend(user); ev({ type: "message_end", message: user }); msgs.push(user);
  let lastText = "";
  let first = true;
  for (const group of groupSteps(spec.steps ?? [{ text: "ok" }])) {
    if (interrupted()) break;
    if (!first) ev({ type: "turn_start" });
    first = false;
    const blocks: any[] = [];
    const part = () => ({ role: "assistant", content: blocks.map((b) => ({ ...b })), api: "stub", provider: model.provider, model: model.id, usage: usage(0), stopReason: "stop", timestamp: Date.now() });
    ev({ type: "message_start", message: part() });
    for (const step of group.content) {
      if (step.hang) { while (!interrupted()) await sleep(25); break; }
      if (step.sleep) { await nap(step.sleep); continue; }
      const text = String(step.text ?? step.thinking ?? "");
      const kind = step.thinking !== undefined ? "thinking" : "text";
      const idx = blocks.push(kind === "thinking" ? { type: "thinking", thinking: text } : { type: "text", text }) - 1;
      ev({ type: "message_update", message: part(), assistantMessageEvent: { type: `${kind}_delta`, contentIndex: idx, delta: text, partial: part() } });
      if (kind === "text") { lastText = text; progress.recentOutput = [text]; }
      report();
    }
    const calls = group.tools.map((step: any) => ({ call: { type: "toolCall", id: `call_${hex8()}`, name: step.tool, arguments: step.args ?? {} }, step }));
    for (const { call: c } of calls) blocks.push(c);
    const fin = { ...part(), usage: usage(blocks.length * 10), stopReason: interrupted() ? "aborted" : calls.length ? "toolUse" : "stop", content: blocks };
    ev({ type: "message_end", message: fin }); subAppend(fin); msgs.push(fin);
    const results: any[] = [];
    for (const { call: c, step } of calls) {
      ev({ type: "tool_execution_start", toolCallId: c.id, toolName: c.name, args: c.arguments });
      const result = { content: [{ type: "text", text: String(step.result ?? "ok") }] };
      toolCount++; progress.recentTools = [...progress.recentTools, { tool: c.name, args: "", endMs: Date.now() }]; report();
      ev({ type: "tool_execution_end", toolCallId: c.id, toolName: c.name, result, isError: !!step.isError });
      const tr = { role: "toolResult", toolCallId: c.id, toolName: c.name, content: result.content, isError: !!step.isError, timestamp: Date.now() };
      ev({ type: "message_start", message: tr }); subAppend(tr); ev({ type: "message_end", message: tr }); results.push(tr); msgs.push(tr);
    }
    ev({ type: "turn_end", message: fin, toolResults: results });
  }
  if (resumeReq && !cancelled) {
    // omp interrupted the turn above and now answers its recovery directive.
    ev({ type: "turn_start" });
    const directive = developerMessage(CONTINUE_TEXT);
    ev({ type: "message_start", message: directive }); subAppend(directive); ev({ type: "message_end", message: directive }); msgs.push(directive);
    const reply = { role: "assistant", content: [{ type: "text", text: "ok" }], api: "stub", provider: model.provider, model: model.id, usage: usage(10), stopReason: "stop", timestamp: Date.now() };
    ev({ type: "message_start", message: { ...reply, content: [] } });
    ev({ type: "message_end", message: reply }); subAppend(reply); msgs.push(reply);
    ev({ type: "turn_end", message: reply, toolResults: [] });
    lastText = "ok";
  }
  if (!cancelled) readSteers();
  ev({ type: "agent_end", messages: msgs, yielded: true });
  const status = cancelled ? "aborted" : "completed";
  progress.status = status; progress.requests = subEntries.filter((e) => e.message?.role === "assistant").length; progress.tokens = progress.requests * 110;
  report();
  subagents.delete(id);
  finishedSubagents.set(id, { call, sessionFile, index });
  lifecycle(status);
  asyncJobs--;
  wakeWith({ customType: "async-result", content: `<system-notice>\nAgent ${id} has ${status}.\n${lastText}\n</system-notice>` });
}

/** `resume` on a finished subagent that is still registered: revived from its transcript, answered, finished again, and the parent woken. */
async function reviveSubagent(id: string, rec: { call: any; sessionFile: string; index: number }, hostMessageId: string | undefined, ack: () => void): Promise<void> {
  const lifecycle = (status: string) => { if (subLevel !== "off") out({ type: "subagent_lifecycle", payload: { id, agent: "task", parentToolCallId: rec.call.id, detached: true, agentSource: "bundled", status, sessionFile: rec.sessionFile, index: rec.index } }); };
  asyncJobs++;
  lifecycle("started");
  ack();
  await sleep(20);
  let last: string | null = parseSessionFile(rec.sessionFile).entries.at(-1)?.id ?? null;
  const lines: string[] = [];
  const add = (type: string, body: Record<string, any>) => {
    const entry: Entry = { type, id: hex8(), parentId: last, timestamp: now(), ...body };
    last = entry.id;
    lines.push(JSON.stringify(entry));
  };
  if (hostMessageId) add("custom", { customType: "host-resume", data: { hostMessageId, text: "." } });
  add("message", { message: developerMessage(CONTINUE_TEXT) });
  add("message", { message: { role: "assistant", content: [{ type: "text", text: "ok" }], api: "stub", provider: model.provider, model: model.id, usage: usage(10), stopReason: "stop", timestamp: Date.now() } });
  appendFileSync(rec.sessionFile, lines.join("\n") + "\n");
  lifecycle("completed");
  asyncJobs--;
  wakeWith({ customType: "async-result", content: `<system-notice>\nAgent ${id} has completed.\nok\n</system-notice>` });
}

// ---------------------------------------------------------------- commands
function stateData() {
  return {
    model: { provider: model.provider, id: model.id, name: model.name },
    thinkingLevel: thinking,
    isStreaming: busy, isCompacting: false, isSettled: isSettled(), hasPendingAsyncWork: asyncJobs > 0, goal: goal ? { enabled: goal.status === "active", mode: "active", goal } : null,
    sessionFile: file ?? newFilePath(header), sessionId: header.id, sessionName: header.title,
    cwd, messageCount: messages().length, queuedMessageCount: queueSize(),
    queuedMessages: { steering: steering.map((q) => q.text), followUp: followUps.map((q) => q.text), liveSteered: 0 },
    todoPhases,
    ...(recapDueAt !== undefined ? { idleMaintenance: { recapDueAt } } : {}), // P4: absent when nothing is owed
  };
}
const modelInfo = (m: typeof MODELS[number]) => ({
  provider: m.provider, id: m.id, name: m.name, reasoning: m.reasoning, input: ["text"],
  contextWindow: 100_000, maxTokens: 8_000, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
});
const AVAILABLE_COMMANDS = [{ name: "pi-vcc", description: "Compact conversation with pi-vcc structured summary" }];
/** omp's `/context` view as `omp session inspect` prints it (the RPC `get_context_breakdown` below keeps the two-category shape test/e2e/context.test.ts asserts). */
function contextBreakdown(m: typeof MODELS[number], list: any[]) {
  const window = 100_000;
  const buffer = 16_384;
  const messageTokens = Math.round(list.reduce((n, x) => n + JSON.stringify(x.content ?? "").length, 0) / 4);
  const categories = [
    { id: "systemPrompt", label: "System prompt", tokens: 1742 },
    { id: "systemTools", label: "System tools", tokens: 4058 },
    { id: "systemContext", label: "System context", tokens: 109 },
    { id: "instructionFiles", label: "Instruction files", tokens: 0 },
    { id: "skills", label: "Skills", tokens: 0 },
    { id: "messages", label: "Messages", tokens: messageTokens },
  ];
  const used = categories.reduce((n, c) => n + c.tokens, 0);
  return { model: { provider: m.provider, modelId: m.id }, contextWindow: window, categories, usedTokens: used, autoCompactBufferTokens: buffer, freeTokens: window - used - buffer, thresholdTokens: window - buffer };
}
function messageEntryOrThrow(entryId: string): Entry {
  const e = entries.find((x) => x.id === entryId);
  if (!e) throw Object.assign(new Error(`Entry ${entryId} not found`), { code: "entry_not_found" });
  return e;
}
/** Copy root→`upTo` into a new session file and move the process onto it. */
function moveToSiblingUpTo(upTo: string | null, extra?: Partial<Header>): void {
  const kept = pathTo(upTo);
  const parent = header.id;
  cancelRecap();
  const parentFile = file;
  fresh(parent);
  header = { ...header, ...(parentFile ? { parentSession: parentFile } : {}), ...extra };
  entries = kept; leaf = upTo;
  claim(header.id); claimed = true;
  releaseLease(parent); // omp's session manager gives up the parent's lease when it moves onto the fork
  file = newFilePath(header);
  writeWhole(file);
}

/** The builtin `/move <dir>`: omp relocates the open session (file, header cwd) and says so as command_output; no agent turn. */
function moveSessionTo(id: string | undefined, arg: string): void {
  const reply = (text: string) => { out({ type: "command_output", text }); respond(id, "prompt", { agentInvoked: false }); };
  if (busy) return reply("Cannot move while streaming.");
  const dest = resolve(cwd, arg);
  let isDir = false;
  try { isDir = statSync(dest).isDirectory(); } catch { /* missing */ }
  if (!isDir) return reply(`Directory does not exist: ${dest}`);
  if (file && existsSync(file)) {
    if (leaseHeldByOther(header.id)) return reply(`Move failed: Cannot move session "${file}": another live omp process writes it. Nothing was moved.`);
    const previous = file;
    header = { ...header, cwd: dest, previousSessionFiles: [...(header.previousSessionFiles ?? []), previous] };
    const next = join(sessionsRoot, sessionDirName(dest), basename(previous));
    mkdirSync(dirname(next), { recursive: true });
    renameSync(previous, next);
    file = next;
    writeWhole(next);
    claim(header.id); claimed = true;
  } else {
    header = { ...header, cwd: dest };
  }
  out({ type: "session_info_update", sessionId: header.id });
  reply(`Moved to ${dest}.`);
}
/** P5: `resume` is the TUI's `.`: continue the session (or a subagent) without journaling a user message. */
async function resumeCommand(id: string | undefined, frame: any): Promise<void> {
  const { subagentId, hostMessageId } = frame;
  if (subagentId !== undefined && (typeof subagentId !== "string" || !subagentId)) return fail(id, "resume", "`subagentId` must be a non-empty string.");
  if (hostMessageId !== undefined && (typeof hostMessageId !== "string" || !hostMessageId)) return fail(id, "resume", "hostMessageId must be a non-empty string");
  if (subagentId !== undefined) {
    const running = subagents.get(subagentId);
    if (running) { running.resume(hostMessageId); return respond(id, "resume"); }
    const finished = finishedSubagents.get(subagentId);
    if (!finished) return fail(id, "resume", `Unknown subagent or session file unavailable: ${subagentId}`);
    void reviveSubagent(subagentId, finished, hostMessageId, () => respond(id, "resume"));
    return;
  }
  // The marker goes in first and stays when nothing can be resumed; the model never sees it (a custom entry).
  if (hostMessageId) append("custom", { customType: "host-resume", data: { hostMessageId, text: "." } });
  if (busy) {
    // A streaming session is interrupted as Esc would; input queued behind it continues the run in place of the directive.
    const queued = queueSize() > 0;
    aborted = true; wake?.();
    await new Promise<void>((r) => abortWaiters.push(r));
    if (queued) {
      const fromSteer = steering.length > 0;
      const head = (fromSteer ? steering.shift() : followUps.shift())!;
      queueUpdate();
      await runAgent(undefined, head.text, { steering: fromSteer, custom: head.custom, hostMessageId: head.hostMessageId });
      return respond(id, "resume");
    }
  }
  const unanswered = unansweredPrompt();
  if (unanswered !== undefined) {
    // An interrupt before any output: the prompt runs again as is; omp answers once the run has started.
    void runAgent(undefined, unanswered, { continueOnly: true, onStart: () => respond(id, "resume") });
    return;
  }
  if (!messages().some((m) => m.role === "user") && !entries.some((e) => e.type === "compaction")) return fail(id, "resume", "Nothing to resume");
  await runAgent(undefined, CONTINUE_TEXT, { synthetic: true });
  respond(id, "resume");
}
// ---------------------------------------------------------------- /btw (modes/rpc/rpc-btw.ts, session/btw-history.ts)
// `btw` runs an ephemeral side turn against the session: no `agent_start`, nothing journaled in the transcript, answered
// from the script by the question. Every turn is checkpointed into `<session file without .jsonl>/btw-history/entry-<id>.json`.
type BtwTurn = { question: string; answer: string; status: string; createdAt: number; updatedAt: number; error?: string };
type BtwRecord = BtwTurn & { id: string; leafId: string | null; followUps?: BtwTurn[] };
let btwRunning: { record: BtwRecord; cancelled: boolean; wake?: () => void } | undefined;
let btwSeq = 0;
const btwDirectory = (): string | undefined => (file ? join(file.replace(/\.jsonl$/, ""), "btw-history") : undefined);
function btwWrite(record: BtwRecord): void {
  const dir = btwDirectory();
  if (!dir) return;
  mkdirSync(dir, { recursive: true });
  const target = join(dir, `entry-${record.id}.json`);
  writeFileSync(`${target}.tmp`, `${JSON.stringify(record)}\n`);
  renameSync(`${target}.tmp`, target);
}
function btwRead(): BtwRecord[] {
  const dir = btwDirectory();
  if (!dir || !existsSync(dir)) return [];
  return readdirSync(dir).filter((name) => name.endsWith(".json")).sort().flatMap((name) => {
    try { return [JSON.parse(readFileSync(join(dir, name), "utf8")) as BtwRecord]; } catch { return []; }
  });
}
function btwPatch(record: BtwRecord, patch: Partial<BtwTurn>): BtwRecord {
  const followUps = record.followUps;
  if (followUps?.length) return { ...record, followUps: [...followUps.slice(0, -1), { ...followUps.at(-1)!, ...patch }] };
  return { ...record, ...patch };
}
function btwFinish(running: NonNullable<typeof btwRunning>, patch: Partial<BtwTurn>): void {
  if (btwRunning !== running) return;
  btwRunning = undefined;
  running.record = btwPatch(running.record, patch);
  out({ type: "btw_record", record: running.record });
  btwWrite(running.record);
}
async function btwRun(running: NonNullable<typeof btwRunning>, question: string): Promise<void> {
  const users = messages().filter((m) => m.role === "user").length;
  const text = pickSteps(question).filter((s) => s.text !== undefined || s.sleep !== undefined);
  let answer = "";
  for (const step of text) {
    if (step.sleep !== undefined) {
      await Promise.race([sleep(Number(step.sleep)), new Promise<void>((r) => { running.wake = r; })]);
    } else {
      for (const piece of chunks(String(step.text).replaceAll("{{users}}", String(users)))) {
        if (running.cancelled) return;
        answer += piece;
        running.record = btwPatch(running.record, { answer, updatedAt: Date.now() });
        out({ type: "btw_delta", recordId: running.record.id, delta: piece });
        await sleep(TICK);
      }
    }
    if (running.cancelled) return;
  }
  btwFinish(running, { answer, status: "complete", updatedAt: Date.now() });
}
function btwAsk(id: string | undefined, frame: any): void {
  const question = typeof frame.question === "string" ? frame.question.trim() : "";
  if (!question) return fail(id, "btw", "btw requires a non-empty question");
  if (btwRunning) return fail(id, "btw", "A /btw question is still running; cancel it first");
  if (!model) return fail(id, "btw", "No active model available for /btw.");
  if (!file || !existsSync(file)) { ensureOwnership(); file = file ?? newFilePath(header); writeWhole(file); }
  const previous = frame.recordId === undefined ? undefined : btwRead().find((r) => r.id === frame.recordId);
  if (frame.recordId !== undefined && !previous) return fail(id, "btw", `Unknown /btw topic: ${frame.recordId}`);
  const at = Date.now();
  const turn: BtwTurn = { question, answer: "", status: "running", createdAt: at, updatedAt: at };
  const record: BtwRecord = previous ? { ...previous, followUps: [...(previous.followUps ?? []), turn] } : { ...turn, id: `${at}${String(++btwSeq).padStart(3, "0")}`, leafId: leaf };
  btwWrite(record);
  const running = { record, cancelled: false } as NonNullable<typeof btwRunning>;
  btwRunning = running;
  out({ type: "btw_record", record });
  respond(id, "btw", { record });
  // A macrotask: the `btw` response is written first, so it never trails this turn's frames.
  setTimeout(() => void btwRun(running, question), 0);
}
function btwCancel(id: string | undefined, frame: any): void {
  const running = btwRunning;
  if (!running || (frame.recordId !== undefined && running.record.id !== frame.recordId)) return respond(id, "btw_cancel", { cancelled: false });
  running.cancelled = true;
  running.wake?.();
  btwFinish(running, { status: "cancelled", updatedAt: Date.now() });
  respond(id, "btw_cancel", { cancelled: true });
}

async function handle(frame: any): Promise<void> {
  const { id, type } = frame as { id?: string; type: string };
  // P1: the host's own message id must be a non-empty string wherever it is accepted.
  if ((type === "prompt" || type === "steer" || type === "follow_up" || type === "abort_and_prompt") && frame.hostMessageId !== undefined && (typeof frame.hostMessageId !== "string" || frame.hostMessageId.length === 0)) {
    return fail(id, type, "hostMessageId must be a non-empty string");
  }
  try {
    switch (type) {
      case "get_state": return respond(id, type, stateData());
      case "get_available_models": return respond(id, type, { models: MODELS.map(modelInfo) });
      case "get_available_commands": return respond(id, type, { commands: AVAILABLE_COMMANDS });
      case "get_available_thinking_levels": return respond(id, type, model.reasoning ? ["off", "low", "medium", "high"] : ["off"]);
      case "set_model": {
        const m = MODELS.find((x) => x.provider === frame.provider && x.id === frame.modelId);
        if (!m) return fail(id, type, `Model not found: ${frame.provider}/${frame.modelId}`);
        model = m;
        append("model_change", { model: `${m.provider}/${m.id}`, role: "default", resolvedModelIsFallback: false });
        return respond(id, type, modelInfo(m));
      }
      case "set_thinking_level": {
        // omp journals the effective level (clamped to what the model supports) only when it changes.
        const level = model.reasoning ? String(frame.level) : "off";
        if (level !== thinking) {
          thinking = level;
          append("thinking_level_change", { thinkingLevel: level, configured: level });
        }
        return respond(id, type);
      }
      case "set_subagent_subscription":
        if (!["off", "progress", "events"].includes(String(frame.level))) return fail(id, type, `Invalid subagent subscription level: ${String(frame.level)}`);
        subLevel = String(frame.level);
        return respond(id, type, { level: subLevel });
      case "set_event_filter": case "set_host_tools": case "set_auto_compaction":
      case "set_auto_retry": case "set_steering_mode": case "set_follow_up_mode": case "set_interrupt_mode": case "set_ask_dialog":
        return respond(id, type, {});
      case "get_subagents": return respond(id, type, { subagents: [...subagents.values()].map((s) => ({ ...s.snapshot, status: "running" })) });
      case "cancel_subagent": {
        const sub = subagents.get(String(frame.subagentId));
        if (sub) sub.cancel();
        return respond(id, type, { cancelled: !!sub });
      }
      case "set_subagent_model": {
        if (!subagents.has(String(frame.subagentId))) return fail(id, type, `Subagent not found: ${String(frame.subagentId)}`);
        if (!MODELS.some((x) => x.provider === frame.provider && x.id === frame.modelId)) return fail(id, type, `Model not found: ${frame.provider}/${frame.modelId}`);
        subagentModels.set(String(frame.subagentId), `${frame.provider}/${frame.modelId}${frame.level ? `:${frame.level}` : ""}`);
        return respond(id, type);
      }
      case "steer_subagent": {
        const target = subagents.get(String(frame.subagentId));
        if (!target) return fail(id, type, `Subagent refused the message: unknown subagent ${String(frame.subagentId)}`);
        target.steer(String(frame.message), frame.hostMessageId);
        return respond(id, type);
      }
      case "get_session_stats": return respond(id, type, { tokens: { input: 100, output: 10, total: 110 }, cost: 0 });
      case "get_context_breakdown": return respond(id, type, {
        model: { provider: model.provider, modelId: model.id }, contextWindow: model.contextWindow ?? 100_000,
        categories: [{ id: "systemPrompt", label: "System prompt", tokens: 30 }, { id: "messages", label: "Messages", tokens: 60 }],
        usedTokens: 100, autoCompactBufferTokens: 10, freeTokens: 99_890,
      });
      case "get_session_lease": {
        const ids: string[] = frame.sessionIds ?? [];
        return respond(id, type, { held: ids.filter((s) => owned.has(s) || leaseHeldByOther(s)), unknown: [] });
      }
      case "switch_session": {
        let claimedId: string | undefined;
        if (frame.claimLease === true) {
          // P3: the target's lease is taken before anything is torn down; a session another process owns is refused.
          try { claimedId = parseSessionFile(frame.sessionPath).header.id; } catch { /* no readable header */ }
          if (!claimedId) return fail(id, type, `No session found at ${frame.sessionPath}`);
          if (leaseHeldByOther(claimedId)) return fail(id, type, "Session is owned by another omp process", "session_busy");
        }
        if (busy) { aborted = true; wake?.(); }
        const leaving = header.id;
        cancelRecap();
        if (!existsSync(frame.sessionPath)) {
          // omp opens a missing path as a new, empty session that writes there (and holds its lease)
          fresh();
          file = frame.sessionPath;
          writeWhole(file);
          claim(header.id); claimed = true;
          releaseLease(leaving);
          return respond(id, type, { cancelled: false });
        }
        load(frame.sessionPath);
        if (claimedId) { claim(header.id); claimed = true; } // held from the open, before any write
        if (header.id !== leaving) releaseLease(leaving);
        return respond(id, type, { cancelled: false });
      }
      case "new_session": {
        // omp forces the file into existence (header only) and takes the lease right away
        const leaving = header.id;
        cancelRecap();
        fresh(frame.parentSession);
        file = newFilePath(header);
        writeWhole(file);
        claim(header.id); claimed = true;
        releaseLease(leaving);
        return respond(id, type, { cancelled: false });
      }
      case "get_messages": return respond(id, type, { messages: messages() });
      case "get_entries": {
        if (frame.since === undefined) return respond(id, type, { entries, leafId: leaf });
        const at = entries.findIndex((e) => e.id === frame.since);
        if (at < 0) return fail(id, type, `Unknown entries cursor: ${String(frame.since)}`, "unknown_since");
        return respond(id, type, { entries: entries.slice(at + 1), leafId: leaf });
      }
      case "get_last_assistant_text": {
        const last = [...messages()].reverse().find((m) => m.role === "assistant");
        const text = last?.content?.filter((b: any) => b.type === "text").map((b: any) => b.text).join("") ?? "";
        return respond(id, type, { text: text || null });
      }
      case "set_session_name": setTitle(frame.name); return respond(id, type);
      case "set_todos": todoPhases = frame.phases ?? []; return respond(id, type, {});
      case "prompt": {
        const text = String(frame.message ?? "");
        if (/^\/move\s+\S/.test(text)) return moveSessionTo(id, text.replace(/^\/move\s+/, "").trim());
        if (!text.trim() && !(frame.images?.length)) return respond(id, type, { agentInvoked: false }); // handled locally, no prompt_result
        if (busy) {
          if (!frame.streamingBehavior) return fail(id, type, "Agent is already processing. Use steer() or followUp() to queue messages, or wait for completion.");
          (frame.streamingBehavior === "steer" ? steering : followUps).push({ text, ticket: openTicket(id, true), hostMessageId: frame.hostMessageId });
          queueUpdate();
          return respond(id, type);
        }
        respond(id, type);
        void runAgent(openTicket(id, false), text, { hostMessageId: frame.hostMessageId });
        return;
      }
      case "steer": case "follow_up": {
        const text = String(frame.message ?? "");
        if (!text.trim()) return respond(id, type);
        if (!busy) { respond(id, type); void runAgent(undefined, text, { steering: type === "steer", hostMessageId: frame.hostMessageId }); return; }
        (type === "steer" ? steering : followUps).push({ text, hostMessageId: frame.hostMessageId });
        queueUpdate();
        return respond(id, type);
      }
      case "goal": {
        const op = String(frame.op);
        if (op === "get") return respond(id, type, { goal, state: goal ? { enabled: goal.status === "active", mode: "active", goal } : null });
        if (op === "create") {
          if (goal && goal.status !== "complete") return fail(id, type, goal.status === "paused" ? "Resume or drop the paused goal before creating another." : "A goal is already active. Drop it before creating another.");
          goal = { id: hex8(), objective: String(frame.objective ?? ""), status: "active", ...(frame.token_budget ? { tokenBudget: frame.token_budget } : {}), tokensUsed: 0 };
          goalSuppressed = false; lastTurnWasContinuation = false; goalTurns = 0; goalEvent();
          if (!busy) { goalScheduled = false; scheduleGoalContinuation(); }
          return respond(id, type, { goal, state: { enabled: true, mode: "active", goal } });
        }
        if (op === "resume") {
          if (goal?.status !== "paused") return fail(id, type, "No paused goal to resume.");
          goal = { ...goal, status: "active" }; goalSuppressed = false; lastTurnWasContinuation = false; goalEvent();
          if (!busy) scheduleGoalContinuation();
          return respond(id, type, { goal, state: { enabled: true, mode: "active", goal } });
        }
        if (op === "pause") { if (goal?.status === "active") { goal = { ...goal, status: "paused" }; goalEvent(); } return respond(id, type, { goal, state: null }); }
        if (op === "drop") { const dropped = goal && { ...goal, status: "dropped" }; goal = null; if (dropped) { append("mode_change", { mode: "none" }); out({ type: "goal_updated", goal: dropped, state: { enabled: false, mode: "active", goal: dropped } }); } return respond(id, type, { goal: null, state: null }); }
        return fail(id, type, `Unknown goal op: ${op}`);
      }
      case "abort": {
        if (goal?.status === "active") { goal = { ...goal, status: "paused" }; goalEvent(); }
        if (!busy) return respond(id, type);
        aborted = true; wake?.();
        abortWaiters.push(() => respond(id, type));
        return;
      }
      case "abort_and_restore_queue": {
        const restored = { steering: steering.splice(0).map((q) => ({ text: q.text })), followUp: followUps.splice(0).map((q) => ({ text: q.text })) };
        queueUpdate();
        if (goal?.status === "active") { goal = { ...goal, status: "paused" }; goalEvent(); }
        if (!busy) return respond(id, type, restored);
        aborted = true; wake?.();
        abortWaiters.push(() => respond(id, type, restored));
        return;
      }
      case "abort_and_prompt": {
        const text = String(frame.message ?? "");
        const start = () => { respond(id, type); void runAgent(openTicket(id, false), text, { hostMessageId: frame.hostMessageId }); };
        if (!busy) return start();
        aborted = true; wake?.();
        abortWaiters.push(start);
        return;
      }
      case "compact": {
        // omp refuses a session too small to summarise (and says so with the manual_compaction frames).
        const size = messages().reduce((n, m) => n + JSON.stringify(m.content ?? "").length, 0);
        out({ type: "manual_compaction_start" });
        if (size < 4000) {
          out({ type: "manual_compaction_end", aborted: false, skipped: true, errorMessage: "Nothing to compact (session too small)" });
          return fail(id, type, "Nothing to compact (session too small)");
        }
        const result = { summary: "Stub summary", shortSummary: "Stub summary", firstKeptEntryId: leaf ?? "", tokensBefore: Math.round(size / 4), details: { readFiles: [], modifiedFiles: [] } };
        append("compaction", result);
        out({ type: "manual_compaction_end", result, aborted: false });
        return respond(id, type, result);
      }
      case "bash": return respond(id, type, { output: "", exitCode: 0 });
      case "export_html": {
        const outputPath = frame.outputPath ?? join(cwd, `omp-session-${header.id}.html`);
        writeFileSync(outputPath, `<!doctype html><title>${header.title ?? header.id}</title><pre>${JSON.stringify(messages())}</pre>`);
        return respond(id, type, { path: outputPath });
      }
      case "navigate_tree": {
        if (busy) return fail(id, type, "Session is busy", "session_busy");
        const target = messageEntryOrThrow(frame.entryId);
        const isUser = target.type === "message" && target.message?.role === "user";
        // A user message rewinds past itself; the leaf is a memory pointer until the next append.
        leaf = isUser ? target.parentId : target.id;
        return respond(id, type, { cancelled: false, ...(isUser ? { editorText: target.message.content?.[0]?.text ?? "" } : {}) });
      }
      case "fork": case "branch": {
        if (busy) return fail(id, type, "Session is busy", "session_busy");
        const target = frame.entryId ? messageEntryOrThrow(frame.entryId) : undefined;
        const upTo = type === "branch" ? (target?.parentId ?? null) : (target?.id ?? leaf);
        moveToSiblingUpTo(upTo);
        return respond(id, type, { cancelled: false, ...(type === "branch" && target ? { text: target.message?.content?.[0]?.text ?? "" } : {}) });
      }
      case "append_custom_entry": {
        if (typeof frame.customType !== "string" || frame.customType.length === 0) return fail(id, type, "customType must be a non-empty string");
        const entry = append("custom", { customType: frame.customType, ...(frame.data !== undefined ? { data: frame.data } : {}) });
        return respond(id, type, { entryId: entry.id });
      }
      case "btw": return btwAsk(id, frame);
      case "btw_cancel": return btwCancel(id, frame);
      case "get_btw_history": {
        const stored = new Map(btwRead().map((r) => [r.id, r]));
        if (btwRunning) stored.set(btwRunning.record.id, btwRunning.record);
        return respond(id, type, { records: [...stored.values()].sort((a, b) => b.createdAt - a.createdAt || a.id.localeCompare(b.id)) });
      }
      case "resume": return resumeCommand(id, frame);
      default: return fail(id, type, `Unknown command: ${type}`);
    }
  } catch (err: any) {
    fail(id, type, err?.message ?? String(err), err?.code);
  }
}

// ---------------------------------------------------------------- one-shot CLI (P6)
// `omp session inspect --json <path|id>`, `omp session lease --json -- <ids>` and `omp models --json`: no RPC child,
// no lease taken, nothing written (test/contract/cli.test.ts holds both binaries to that).
const NO_DEFAULT_MODEL = "No default model selected. Use /login, set an API key environment variable, or select a local model with /model or --model.";

function findSessionFile(source: string): string {
  if (source.includes("/") || source.endsWith(".jsonl")) {
    const path = resolve(process.cwd(), source);
    if (!existsSync(path)) throw new Error(`Session file not found: ${path}`);
    if (statSync(path).isDirectory()) throw new Error("Directories cannot be read like files");
    return path;
  }
  const walk = (dir: string): string | undefined => {
    if (!existsSync(dir)) return undefined;
    for (const e of readdirSync(dir, { withFileTypes: true })) {
      const p = join(dir, e.name);
      if (e.isDirectory()) { const hit = walk(p); if (hit) return hit; } else if (e.name.endsWith(`_${source}.jsonl`)) return p;
    }
    return undefined;
  };
  const hit = walk(sessionsRoot);
  if (!hit) throw new Error(`Session not found: ${source}`);
  return hit;
}

function inspectSession(path: string): Record<string, unknown> {
  let parsed: { header: Header; entries: Entry[] };
  try { parsed = parseSessionFile(path); } catch { throw new Error(`Cannot resume session "${path}": the session header is missing or malformed. The file was not modified.`); }
  const journal = [...parsed.entries].reverse();
  const requested = (() => {
    for (const e of journal) {
      if (e.type === "model_change") return String(e.model);
      if (e.type === "message" && e.message?.role === "assistant") return `${e.message.provider}/${e.message.model}`;
    }
    return null;
  })();
  const found = requested ? MODELS.find((m) => `${m.provider}/${m.id}` === requested) : undefined;
  const chosen = found ?? MODELS[0] ?? null;
  // A saved model that cannot be restored does not fail the inspection: the model actually selected is reported with why.
  const modelFallback = found || (!requested && chosen)
    ? undefined
    : { requested, reason: chosen ? `Could not restore model ${requested}. Using ${chosen.provider}/${chosen.id}` : requested ? `Could not restore model ${requested}. ${NO_DEFAULT_MODEL}` : NO_DEFAULT_MODEL };
  const savedLevel = journal.find((e) => e.type === "thinking_level_change")?.thinkingLevel;
  const thinkingLevel = !chosen ? "high" : chosen.reasoning ? (savedLevel ?? "high") : null;
  const branchMessages = pathTo(parsed.entries.at(-1)?.id ?? null).filter((e) => e.type === "message").map((e) => e.message);
  return {
    sessionId: parsed.header.id,
    title: parsed.header.title || null,
    model: chosen ? { provider: chosen.provider, modelId: chosen.id } : null,
    ...(modelFallback ? { modelFallback } : {}),
    thinkingLevel,
    contextBreakdown: chosen ? contextBreakdown(chosen, branchMessages) : null,
    ...(chosen ? {} : { contextBreakdownReason: "no model is selected for this session" }),
    availableCommands: AVAILABLE_COMMANDS,
    todoPhases: [],
    goal: null,
    leaseHeld: leaseHeldByOther(parsed.header.id),
  };
}

function runCli(): number {
  const [command, action, ...rest] = argv;
  const usage = (text: string) => { process.stderr.write(`error: ${text}\n`); return 1; };
  try {
    if (command === "models") {
      if (!argv.includes("--json")) return usage("the stub prints models only with --json");
      process.stdout.write(JSON.stringify({
        models: MODELS.map((m) => ({
          provider: m.provider, kind: "chat", id: m.id, selector: `${m.provider}/${m.id}`, name: m.name, contextWindow: 100_000, maxTokens: 8_000,
          reasoning: m.reasoning, thinking: m.reasoning ? ["minimal", "low", "medium", "high", "xhigh"] : null, input: ["text"],
          cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }, pricingStatus: "unknown",
        })),
      }) + "\n");
      return 0;
    }
    if (command === "session" && action === "lease") {
      const dashes = rest.indexOf("--");
      const ids = dashes >= 0 ? rest.slice(dashes + 1) : rest.filter((a) => !a.startsWith("-"));
      if (ids.length === 0) return usage("Missing session id. Usage: omp session lease [--json] -- <session-id>...");
      if (!rest.includes("--json")) return usage("the stub prints leases only with --json");
      process.stdout.write(JSON.stringify({ held: ids.filter((s) => leaseHeldByOther(s)), unknown: [] }) + "\n");
      return 0;
    }
    if (command === "session" && action === "inspect") {
      const usageText = "omp session inspect --json <session>";
      if (!rest.includes("--json")) return usage(`inspect only prints JSON. Usage: ${usageText}`);
      const sources = rest.filter((a) => !a.startsWith("-"));
      if (sources.length === 0) return usage(`Missing session. Usage: ${usageText}`);
      process.stdout.write(JSON.stringify(inspectSession(findSessionFile(sources[0]!))) + "\n");
      return 0;
    }
    return usage(`the stub does not implement: omp ${argv.join(" ")}`);
  } catch (err: any) {
    return usage(err?.message ?? String(err));
  }
}
if (argv[0] === "session" || argv[0] === "models") process.exit(runCli());
// Print mode (`omp -p ... -- <prompt>`): one model turn, which the sidecar runs for small-model text. Recorded as a
// `print` frame so a test can assert that no model was asked.
if (argv.includes("-p")) {
  const prompt = argv[argv.indexOf("--") + 1] ?? "";
  if (process.env.OMP_STUB_RECORD) appendFileSync(process.env.OMP_STUB_RECORD, JSON.stringify({ type: "print", model: flag("--model"), prompt }) + "\n");
  process.stdout.write("stub print reply\n");
