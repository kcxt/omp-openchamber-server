  while ((nl = buffer.indexOf("\n")) >= 0) {
    const line = buffer.slice(0, nl).trim();
    buffer = buffer.slice(nl + 1);
    if (!line) continue;
    if (record) appendFileSync(record, line + "\n");
    let frame: any;
    try { frame = JSON.parse(line); } catch { fail(undefined, "parse", "Failed to parse command: invalid JSON"); continue; }
