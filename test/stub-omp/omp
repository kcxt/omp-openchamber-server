    if (cancelled) break;
    if (!first) ev({ type: "turn_start" });
    first = false;
    const blocks: any[] = [];
    const part = () => ({ role: "assistant", content: blocks.map((b) => ({ ...b })), api: "stub", provider: model.provider, model: model.id, usage: usage(0), stopReason: "stop", timestamp: Date.now() });
