#!/usr/bin/env bun
// Offline stand-in for `omp --mode rpc`, for the sidecar's end-to-end tests.
//
// It speaks the same stdio JSONL protocol as omp (docs/rpc.md in oh-my-pi) and
// persists sessions the way omp does, so the sidecar's on-disk readers and its
// RPC driving are exercised for real:
//   - sessions live in `$PI_CODING_AGENT_DIR/sessions/<encoded cwd>/<ts>_<id>.jsonl`
//     (default `~/.omp/agent`), with omp's directory encoding, a 256-byte title
//     slot, a `type:"session"` header and `id`/`parentId` entry trees;
//   - a process owns a session through a lease; a writer that finds the lease held
//     by another live process moves to a sibling file (new id, `parentSession`
//     pointing back) instead of writing the owner's file (docs/session.md);
//   - `navigate_tree`, `fork`, `branch`, `get_entries` and `/move` work on that tree;
//   - runs follow omp's activity-stretch model (docs/omp-protocol.md §4): steers and follow-ups join the
//     live run, `abort` strands queued input, `session_settled` closes the stretch. test/contract/ asserts
//     every behaviour here against the real omp.
//
// No network, no credentials: replies come from a script.
//
//   OMP_STUB_SCRIPT  JSON file, re-read on every prompt:
//                    {"turns":[{"when":"<substring of the prompt>","steps":[...]}]}
//                    The first turn whose `when` is contained in the prompt (or
//                    has none) runs; with no match the stub echoes the prompt.
//                    Steps: {"text"} ("{{users}}" expands to the number of user
//                    messages in omp's current context) {"thinking"} {"sleep":ms} {"hang":true}
//                    {"goalComplete":true} (the agent calls the goal tool; omp keeps running goal turns "(#n)" while a goal is active)
//                    {"fail":"message"} {"crash":true} (process dies mid-turn) {"tool":"bash","args":{},"result":"text",
//                    "isError":bool,"details":{}}; a bash call with args.async=true returns at once and wakes the
//                    session after "asyncMs" (default 300) like a background job; {"tool":"task","args":{"name","task",
//                    "solutionSpace"},"subagent":{"steps":[...]}} spawns a detached subagent (lifecycle/progress/event
//                    frames per set_subagent_subscription; steps as here, {"hang":true} until cancel_subagent)
//   OMP_STUB_RECORD  file that receives every inbound frame (JSONL)
//   OMP_STUB_TICK_MS pause between streamed chunks (default 4)
//   OMP_STUB_START_DELAY_MS  time before the first command is handled, like a slow-booting omp (default 0)
//   OMP_STUB_PROVIDER  provider id of the stub's models (default "stub")
import { appendFileSync, existsSync, mkdirSync, readFileSync, readdirSync, realpathSync, renameSync, statSync, unlinkSync, writeFileSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { basename, dirname, isAbsolute, join, relative, resolve } from "node:path";
import { randomUUID } from "node:crypto";

const VERSION = "18.2.8";
if (process.argv.includes("--version")) {
  console.log(`omp/${VERSION}`);
  process.exit(0);
}

const argv = process.argv.slice(2);
const flag = (name: string) => {
  const i = argv.indexOf(name);
  return i >= 0 ? argv[i + 1] : undefined;
};
const cwd = resolve(flag("--cwd") ?? process.cwd());
const agentDir = process.env.PI_CODING_AGENT_DIR ?? join(homedir(), ".omp", "agent");
const sessionsRoot = join(agentDir, "sessions");
const leaseDir = process.env.PI_TEST_SESSION_OWNERS_DIR ?? join(dirname(agentDir), "run", "session-owners");
const TICK = Number(process.env.OMP_STUB_TICK_MS ?? 4);
const PROVIDER = process.env.OMP_STUB_PROVIDER ?? "stub";
const MODELS = [
  { provider: PROVIDER, id: "fast", name: "Stub Fast", reasoning: false },
  { provider: PROVIDER, id: "smart", name: "Stub Smart", reasoning: true },
];

// ---------------------------------------------------------------- directory layout
function realpath(p: string): string {
  try { return realpathSync(p); } catch { return resolve(p); }
}
function within(rel: string): boolean {
  return rel !== ".." && !rel.startsWith(`..${"/"}`) && !isAbsolute(rel);
}
function encodeRel(prefix: string, rel: string): string {
  const enc = rel.replace(/[/\\:]/g, "-");
  return enc ? (prefix.endsWith("-") ? `${prefix}${enc}` : `${prefix}-${enc}`) : prefix;
}
/** omp's bucket name for a cwd: `-<rel>` under home, `-tmp-<rel>` under tmp, else `--<abs>--`. */
function sessionDirName(dir: string): string {
  const canon = realpath(dir);
  const homeRel = relative(realpath(homedir()), canon);
  const tmpRel = relative(realpath(tmpdir()), canon);
  if (within(tmpRel)) return encodeRel("-tmp", tmpRel);
  if (within(homeRel)) return encodeRel("-", homeRel);
  return `--${canon.replace(/^[/\\]/, "").replace(/[/\\:]/g, "-")}--`;
}

// ---------------------------------------------------------------- leases
const leasePath = (id: string) => join(leaseDir, id);
function alive(pid: number): boolean {
  try { process.kill(pid, 0); return true; } catch { return false; }
}
function leaseHeldByOther(id: string): boolean {
  try {
    const pid = Number(readFileSync(leasePath(id), "utf8"));
    return Number.isFinite(pid) && pid !== process.pid && alive(pid);
  } catch { return false; }
}
const owned = new Set<string>();
function claim(id: string): void {
  mkdirSync(leaseDir, { recursive: true });
  writeFileSync(leasePath(id), String(process.pid));
  owned.add(id);
}
function releaseAll(): void {
  for (const id of owned) {
    try { if (readFileSync(leasePath(id), "utf8") === String(process.pid)) unlinkSync(leasePath(id)); } catch { /* gone */ }
  }
  owned.clear();
}

// ---------------------------------------------------------------- session state
type Entry = Record<string, any> & { id: string; parentId: string | null; type: string };
type Header = Record<string, any> & { id: string; cwd: string };

const hex8 = () => randomUUID().slice(0, 8);
const now = () => new Date().toISOString();

let header: Header = { type: "session", version: 3, id: randomUUID(), timestamp: now(), cwd };
let file: string | null = null; // set once the session is first written
let entries: Entry[] = [];
let leaf: string | null = null;
let model = MODELS[0]!;
let thinking = "off";
let todoPhases: any[] = [];
let claimed = false;
// omp's goal mode: the agent completes it with the `goal` tool; while it is active omp keeps
// running continuation turns by itself (goal.continuationModes includes "rpc").
let goal: { id: string; objective: string; status: string; tokenBudget?: number; tokensUsed: number } | null = null;
let goalScheduled = false;
let goalSuppressed = false;
let lastTurnWasContinuation = false;
let goalTurns = 0;
const GOAL_CONTINUATION = "The session goal is still open. Take it through to the end in this run.";
const goalEvent = () => out({ type: "goal_updated", goal, state: goal ? { enabled: goal.status === "active", mode: "active", goal } : undefined });
function scheduleGoalContinuation(): void {
  if (goalScheduled || goalSuppressed || busy || aborted || goal?.status !== "active") return;
  goalScheduled = true;
  stretchActive = true; // a reported pending goal turn opens a stretch that still ends with session_settled
  setTimeout(() => {
    goalScheduled = false;
    if (!busy && goal?.status === "active" && !goalSuppressed) void runAgent(undefined, `${GOAL_CONTINUATION} (#${++goalTurns})`);
    else settleCheck();
  }, 30);
}

function titleSlot(title = ""): string {
  const base = { type: "title", v: 1, title, updatedAt: now(), pad: "" };
  const used = Buffer.byteLength(JSON.stringify(base)) + 1;
  return JSON.stringify({ ...base, pad: " ".repeat(Math.max(0, 256 - used)) }) + "\n";
}
function newFilePath(h: Header): string {
  return join(sessionsRoot, sessionDirName(h.cwd), `${h.timestamp.replace(/[:.]/g, "-")}_${h.id}.jsonl`);
}
function writeWhole(path: string): void {
  mkdirSync(dirname(path), { recursive: true });
  const body = [JSON.stringify(header), ...entries.map((e) => JSON.stringify(e))].join("\n") + "\n";
  writeFileSync(path, titleSlot(header.title) + body);
}

/** Take the session's lease; if another live process owns it, move to a sibling session. */
function ensureOwnership(): void {
  if (claimed) return;
  if (leaseHeldByOther(header.id)) {
    header = { ...header, id: randomUUID(), timestamp: now(), parentSession: header.id };
    file = null;
  }
  claim(header.id);
  claimed = true;
}
function persist(entry: Entry): void {
  // Like omp (session-manager.ts #shouldHaveSessionFile): a session that has produced no assistant
  // message has no file and holds no lease; entries stay in memory until the first one arrives.
  if (!file || !existsSync(file)) {
    if (!entries.some((e) => e.type === "message" && e.message?.role === "assistant")) return;
    ensureOwnership();
    file = file ?? newFilePath(header);
    writeWhole(file); // header + every entry so far (a moved session publishes its whole transcript)
    return;
  }
  ensureOwnership();
  appendFileSync(file, JSON.stringify(entry) + "\n");
}
function append(type: string, body: Record<string, any>): Entry {
  const entry: Entry = { type, id: hex8(), parentId: leaf, timestamp: now(), ...body };
  entries.push(entry);
  leaf = entry.id;
  persist(entry);
  return entry;
}

function parseSessionFile(path: string): { header: Header; entries: Entry[] } {
  let hdr: Header | undefined;
  const list: Entry[] = [];
  for (const line of readFileSync(path, "utf8").split("\n")) {
    if (!line.trim()) continue;
    let rec: any;
    try { rec = JSON.parse(line); } catch { continue; }
    if (rec.type === "session" && !hdr) hdr = rec;
    else if (rec.type === "title") hdr = hdr ? { ...hdr, title: rec.title || hdr.title } : hdr;
    else if (rec.type !== "session") list.push(rec); // id-less records stay in the list like omp's: they leave the leaf undefined
  }
  if (!hdr) throw new Error(`Not a session file: ${path}`);
  return { header: hdr, entries: list };
}
function load(path: string): void {
  const parsed = parseSessionFile(path);
  header = parsed.header;
  entries = parsed.entries;
  leaf = entries.length ? ((entries[entries.length - 1]!.id as string | undefined) ?? (undefined as unknown as null)) : null;
  file = path;
  claimed = false; // the lease is taken by the first write, not by opening
  // the session journal decides the model and effort: the latest model_change or assistant message, the latest thinking_level_change
  for (const e of [...entries].reverse()) {
    const spec = e.type === "model_change" ? String(e.model) : e.type === "message" && e.message?.role === "assistant" ? `${e.message.provider}/${e.message.model}` : undefined;
    const found = spec ? MODELS.find((m) => `${m.provider}/${m.id}` === spec) : undefined;
    if (found) { model = found; break; }
  }
  const lastThinking = [...entries].reverse().find((e) => e.type === "thinking_level_change");
  thinking = lastThinking?.thinkingLevel ?? "off";
  todoPhases = [];
}
function fresh(parentSession?: string): void {
  header = { type: "session", version: 3, id: randomUUID(), timestamp: now(), cwd, ...(parentSession ? { parentSession } : {}) };
  entries = []; leaf = null; file = null; claimed = false; todoPhases = [];
}
function pathTo(id: string | null): Entry[] {
  const byId = new Map(entries.map((e) => [e.id, e]));
  const out: Entry[] = [];
  for (let e = id ? byId.get(id) : undefined; e; e = e.parentId ? byId.get(e.parentId) : undefined) out.unshift(e);
  return out;
}
const branch = () => pathTo(leaf);
const messages = () => branch().filter((e) => e.type === "message").map((e) => e.message);

// ---------------------------------------------------------------- protocol output
function out(frame: Record<string, unknown>): void {
  process.stdout.write(JSON.stringify(frame) + "\n");
}
function respond(id: string | undefined, command: string, data?: unknown): void {
  out({ ...(id ? { id } : {}), type: "response", command, success: true, ...(data !== undefined ? { data } : {}) });
}
function fail(id: string | undefined, command: string, error: string, code?: string): void {
  out({ ...(id ? { id } : {}), type: "response", command, success: false, error, ...(code ? { code } : {}) });
}
const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

// ---------------------------------------------------------------- turns
// Mirrors omp's RPC activity model (modes/rpc/rpc-session-settle.ts, rpc-prompt-results.ts):
//   - one `agent_start` … `agent_end` run absorbs steers and follow-ups queued while it streams;
//   - a prompt accepted into a live run reports `prompt_result` at the first yield with the queue drained;
//   - `session_settled` closes the stretch once nothing is live, queued, async or scheduled;
//   - a queued message stranded by a plain `abort` keeps the stretch open (omp does the same).
let busy = false; // a run is live
let aborted = false;
let wake: (() => void) | undefined;
let stretchActive = false; // agent activity since the last session_settled
let runCount = 0;
let messageSeq = 0;
let asyncJobs = 0; // background bash jobs and detached subagents
let subLevel = "off";
type Ticket = { id?: string; queued: boolean; run?: number };
type QueueItem = { text: string; ticket?: Ticket; custom?: { customType: string; content: string } };
const steering: QueueItem[] = [];
const followUps: QueueItem[] = [];
const tickets = new Set<Ticket>();
const abortWaiters: Array<() => void> = [];
const queueSize = () => steering.length + followUps.length;
const isSettled = () => !busy && queueSize() === 0 && asyncJobs === 0 && !goalScheduled;
const queueUpdate = () => out({ type: "queue_update", steering: steering.map((q) => q.text), followUp: followUps.map((q) => q.text), liveSteered: 0 });
function openTicket(id: string | undefined, queued: boolean): Ticket {
  const t: Ticket = { id, queued };
  tickets.add(t);
  return t;
}

async function pause(ms: number): Promise<void> {
  if (aborted) return;
  await Promise.race([sleep(ms), new Promise<void>((r) => { wake = r; })]);
  wake = undefined;
}

function pickSteps(prompt: string): any[] {
  let script: { turns?: Array<{ when?: string; steps: any[] }> } = {};
  const path = process.env.OMP_STUB_SCRIPT;
  if (path && existsSync(path)) {
    try { script = JSON.parse(readFileSync(path, "utf8")); } catch { /* fall through to echo */ }
  }
  const turn = script.turns?.find((t) => !t.when || prompt.includes(t.when));
  return turn?.steps ?? [{ text: `Echo: ${prompt}` }];
}
function usage(outTokens: number) {
  return { input: 100, output: outTokens, cacheRead: 0, cacheWrite: 0, totalTokens: 100 + outTokens, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } };
}
function chunks(text: string): string[] {
  return text.match(/[\s\S]{1,6}/g) ?? [];
}
/** Steps become assistant messages: content steps, then the tool calls they make; the next group is the reply to the results. */
function groupSteps(steps: any[]): Array<{ content: any[]; tools: any[] }> {
  const groups: Array<{ content: any[]; tools: any[] }> = [];
  let cur = { content: [] as any[], tools: [] as any[] };
  for (const step of steps) {
    if (step.tool) cur.tools.push(step);
    else {
      if (cur.tools.length) { groups.push(cur); cur = { content: [], tools: [] }; }
      cur.content.push(step);
    }
  }
  if (cur.content.length || cur.tools.length) groups.push(cur);
  return groups;
}
/** Message lifecycle frames carry a `messageId` shared by start, updates and end (rpc-types.ts RpcMessageEventFrame). */
const newMessageId = () => `msg-${++messageSeq}`;

/** A wake source (finished background job or subagent): joins the live run as a follow-up, or starts one. */
function wakeWith(custom: { customType: string; content: string }): void {
  if (busy) { followUps.push({ text: custom.content, custom }); queueUpdate(); }
  else void runAgent(undefined, custom.content, { custom });
}

function settleCheck(): void {
  if (!stretchActive || busy) return;
  if (goalScheduled) { goalScheduled = false; scheduleGoalContinuation(); return; }
  if (!isSettled()) return;
  stretchActive = false;
  out({ type: "session_settled" });
}

function reportTickets(runNo: number, outcome: { status: string; failure?: string }): void {
  const drained = queueSize() === 0;
  for (const t of [...tickets]) {
    if (t.queued ? !drained : t.run !== runNo) continue;
    tickets.delete(t);
    out({ type: "prompt_result", ...(t.id ? { id: t.id } : {}), agentInvoked: true, status: outcome.status, ...(outcome.failure ? { error: { message: outcome.failure, retryable: false } } : {}), sessionSettled: isSettled() });
  }
}

async function runAgent(ticket: Ticket | undefined, text: string, first: { steering?: boolean; custom?: QueueItem["custom"] } = {}): Promise<void> {
  // Like omp's extension commands: a notify frame and no agent turn at all.
  if (!first.custom) {
    const local = (): void => {
      if (!ticket) return;
      tickets.delete(ticket);
      out({ type: "prompt_result", ...(ticket.id ? { id: ticket.id } : {}), agentInvoked: false, status: "completed", sessionSettled: isSettled() });
    };
    if (text.startsWith("/pi-vcc skip")) {
      out({ type: "manual_compaction_start" });
      out({ type: "manual_compaction_end", aborted: false, skipped: true, errorMessage: "Nothing to compact: the session is empty." });
      return local();
    }
    if (text.startsWith("/pi-vcc output")) {
      out({ type: "command_output", text: "Context: 40 of 100000 tokens used." });
      return local();
    }
    if (text.startsWith("/pi-vcc")) {
      out({ type: "extension_ui_request", id: hex8(), method: "notify", message: "Nothing to compact yet.", notifyType: "warning" });
      return local();
    }
  }
  const runNo = ++runCount;
  busy = true; aborted = false; stretchActive = true;
  if (ticket) ticket.run = runNo;
  out({ type: "agent_start" });
  const newMessages: any[] = [];
  let turnOpen = false;
  let failure: string | undefined;

  const deliver = (body: string, opts: { steering?: boolean; custom?: QueueItem["custom"] }) => {
    out({ type: "turn_start" });
    turnOpen = true;
    const mid = newMessageId();
    if (opts.custom) {
      const message = { role: "custom", customType: opts.custom.customType, content: opts.custom.content, display: true, attribution: "agent", timestamp: Date.now() };
      out({ type: "message_start", message, messageId: mid });
      append("custom_message", { customType: opts.custom.customType, content: opts.custom.content, display: true });
      out({ type: "message_end", message, messageId: mid });
      newMessages.push(message);
      return;
    }
    const message = { role: "user", content: [{ type: "text", text: body }], ...(opts.steering ? { steering: true } : {}), attribution: "user", timestamp: Date.now() };
    out({ type: "message_start", message, messageId: mid });
    append("message", { message });
    out({ type: "message_end", message, messageId: mid });
    newMessages.push(message);
  };

  const runGroup = async (group: { content: any[]; tools: any[] }): Promise<void> => {
    if (!turnOpen) out({ type: "turn_start" });
    turnOpen = false;
    const mid = newMessageId();
    const blocks: any[] = [];
    const partial = () => ({ role: "assistant", content: blocks.map((b) => ({ ...b })), api: "stub", provider: model.provider, model: model.id, usage: usage(0), stopReason: "stop", timestamp: Date.now() });
    out({ type: "message_start", message: partial(), messageId: mid });
    const event = (e: Record<string, unknown>) => out({ type: "message_update", message: partial(), messageId: mid, assistantMessageEvent: { ...e, partial: partial() } });

    for (const step of group.content) {
      if (aborted) break;
      if (step.crash) process.exit(7); // dies like a segfault/OOM kill: no frames, no cleanup
      if (step.fail) { failure = String(step.fail); break; }
      if (step.sleep) { await pause(step.sleep); continue; }
      if (step.goalComplete) {
        if (goal) { goal = { ...goal, status: "complete" }; goalEvent(); }
        continue;
      }
      if (step.hang) { while (!aborted) await pause(60_000); break; }
      const kind = step.thinking !== undefined ? "thinking" : "text";
      // `{{users}}` lets a script show how much context omp itself still holds.
      const full: string = String(step.thinking ?? step.text ?? "").replaceAll("{{users}}", String(messages().filter((m) => m.role === "user").length));
      const index = blocks.push(kind === "thinking" ? { type: "thinking", thinking: "" } : { type: "text", text: "" }) - 1;
      event({ type: `${kind}_start`, contentIndex: index });
      for (const piece of chunks(full)) {
        if (aborted) break;
        blocks[index][kind === "thinking" ? "thinking" : "text"] += piece;
        event({ type: `${kind}_delta`, contentIndex: index, delta: piece });
        await pause(TICK);
      }
      event({ type: `${kind}_end`, contentIndex: index, content: blocks[index][kind === "thinking" ? "thinking" : "text"] });
    }
    const calls: any[] = [];
    for (const step of group.tools) {
      if (aborted || failure) break;
      const call = { type: "toolCall", id: `call_${hex8()}`, name: step.tool, arguments: step.args ?? {} };
      const index = blocks.push({ ...call, arguments: {} }) - 1;
      event({ type: "toolcall_start", contentIndex: index });
      const json = JSON.stringify(call.arguments);
      for (const piece of chunks(json)) { event({ type: "toolcall_delta", contentIndex: index, delta: piece }); await pause(TICK); }
      blocks[index] = call;
      event({ type: "toolcall_end", contentIndex: index, toolCall: call });
      calls.push({ call, step });
    }

    const final = {
      role: "assistant", content: blocks, api: "stub", provider: model.provider, model: model.id,
      usage: usage(blocks.length * 10),
      contextSnapshot: { promptTokens: 100, nonMessageTokens: 40, toolSchemaTokens: 10 },
      stopReason: failure ? "error" : aborted ? "aborted" : calls.length ? "toolUse" : "stop",
      ...(failure ? { errorMessage: failure } : {}),
      ...(aborted ? { errorMessage: "Request was aborted" } : {}),
      timestamp: Date.now(),
    };
    append("message", { message: final });
    out({ type: "message_end", message: final, messageId: mid });
    newMessages.push(final);

    const results: any[] = [];
    if (!final.stopReason.match(/error|aborted/)) {
      for (const { call, step } of calls) {
        out({ type: "tool_execution_start", toolCallId: call.id, toolName: call.name, args: call.arguments });
        if (step.sleep) await pause(step.sleep);
        let text = String(step.result ?? "ok");
        if (call.name === "bash" && call.arguments?.async === true) {
          // A background job: the call returns at once, the finished job wakes the session later.
          const job = `bg_${++asyncSeq}`;
          text = `Command running as background job ${job}.`;
          asyncJobs++;
          setTimeout(() => {
            asyncJobs--;
            wakeWith({ customType: "async-result", content: `<system-notice>\nBackground job ${job} (${String(call.arguments.command ?? "")}) has completed.\nResume your work using the result below.\n${String(step.result ?? "ok")}\n</system-notice>` });
          }, Number(step.asyncMs ?? 300));
        } else if (call.name === "task" && step.subagent) {
          // omp's task tool spawns a detached agent and returns at once; frames follow on the parent's stream.
          const name = String(call.arguments?.name ?? `Agent${subIndex + 1}`);
          text = `Spawned agent \`${name}\` (job \`${name}\`).`;
          asyncJobs++;
          setTimeout(() => { void runSubagent(call, step.subagent); }, 20);
        }
        out({ type: "tool_execution_update", toolCallId: call.id, toolName: call.name, args: call.arguments, partialResult: { content: [{ type: "text", text }] } });
        if (call.name === "todo" && step.details?.phases) todoPhases = step.details.phases;
        const result = { content: [{ type: "text", text }], ...(step.details ? { details: step.details } : {}) };
        out({ type: "tool_execution_end", toolCallId: call.id, toolName: call.name, result, isError: !!step.isError });
        const msg = { role: "toolResult", toolCallId: call.id, toolName: call.name, content: result.content, ...(step.details ? { details: step.details } : {}), isError: !!step.isError, timestamp: Date.now() };
        const rid = newMessageId();
        out({ type: "message_start", message: msg, messageId: rid });
        append("message", { message: msg });
        out({ type: "message_end", message: msg, messageId: rid });
        results.push(msg); newMessages.push(msg);
      }
    }
    out({ type: "turn_end", message: final, toolResults: results });
  };

  deliver(text, first);
  let groups = groupSteps(pickSteps(text));
  let gi = 0;
  for (;;) {
    if (!aborted && !failure) {
      // Delivery point: steers go in at the next turn boundary, follow-ups once the model has nothing more to say.
      const fromSteer = steering.length > 0;
      const next = fromSteer ? steering.shift() : gi >= groups.length ? followUps.shift() : undefined;
      if (next) {
        queueUpdate();
