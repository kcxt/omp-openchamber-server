}
const modelInfo = (m: typeof MODELS[number]) => ({
  provider: m.provider, id: m.id, name: m.name, reasoning: m.reasoning, input: ["text"],
  contextWindow: 100_000, maxTokens: 8_000, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
