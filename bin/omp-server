#!/bin/sh
# Foreground entrypoint for the omp OpenChamber sidecar.
#
# ~/bin/omp-server is a symlink to this file (see install.sh) and the systemd
# user unit execs that symlink, so a checkout update plus a service restart is
# the whole release path: no path to this checkout is baked into the unit.

repo=$(dirname "$(dirname "$(readlink -f "$0")")")
bun=${BUN:-/usr/bin/bun}
omp_bin=${OMP_BIN:-$HOME/bin/omp}

# The sidecar is the backend for `openchamber serve` (bin/openchamber-serve), so
# it stays on loopback: it has no auth of its own. Set OC_SIDECAR_HOST to expose
# it directly (for OpenChamber's Remote Instances without the web server).
host=${OC_SIDECAR_HOST:-127.0.0.1}

# The sidecar writes goal results through OpenChamber's metadata route so every
# open UI is told (src/adapters/openchamber/metadata-bridge.ts): point it at the
# address OpenChamber actually binds.
. "$repo/bin/openchamber-address" 2>/dev/null
case "$openchamber_host" in *:*) openchamber_host="[$openchamber_host]" ;; esac
export OC_OPENCHAMBER_URL=${OC_OPENCHAMBER_URL:-http://$openchamber_host:$openchamber_port}

[ -x "$bun" ] || {
    echo "omp-server: no bun executable at $bun (set BUN=)" >&2
    exit 1
}
[ -d "$repo/node_modules" ] || {
    echo "omp-server: dependencies missing, run 'bun install' in $repo" >&2
    exit 1
}
[ -x "$omp_bin" ] || {
    echo "omp-server: no omp executable at $omp_bin (set OMP_BIN=)" >&2
    exit 1
}

cd "$repo" || exit 1
exec "$bun" run src/main.ts --binary "$omp_bin" --host "$host" "$@"
