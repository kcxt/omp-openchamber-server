# systemd user unit for the omp sidecar: the OpenCode-compatible backend that
# openchamber.service (the web UI) talks to. Its port is held by omp-server.socket.
#
# install.sh symlinks this file into ~/.config/systemd/user and links
# ~/bin/omp-server to bin/omp-server in this checkout. ExecStart runs that
# link, so `git pull` in the checkout + `systemctl --user restart omp-server`
# is the whole update path: nothing in this unit points at a checkout path.
#
# A restart does not touch running omp sessions (docs/handover.md): every omp
# child is its own unit (an instance of omp-child@.service), the socket stays open,
# and the new sidecar adopts the children it finds. The agents' sandbox is
# omp-child@.service; this unit's own is below. Both share one
# private /tmp (JoinsNamespaceOf=, set on each child), and so does the terminal
# of openchamber.service.

[Unit]
Description=omp OpenChamber sidecar (OpenCode API backend)
Documentation=https://github.com/alvins82/omp-openchamber-server
Requires=omp-server.socket
After=omp-server.socket

[Service]
Type=simple
ExecStart=%h/bin/omp-server
Environment=OMP_BIN=%h/bin/omp
# Children as transient units + the handover state they are adopted from. The directory is inside a bound path
# of the sandbox (ProtectHome=tmpfs hides /run/user).
Environment=OC_CHILD_SUPERVISOR=systemd
Environment=OC_SUPERVISOR_DIR=%h/.cache/omp-sidecar
# Per-request access log, off by default:
# Environment=LOG_LEVEL=debug
# Optional secrets (EXA_API_KEY, NVIDIA_API_KEY, ...); missing file is ignored.
EnvironmentFile=-%h/.config/omp-openchamber-server/env
Restart=on-failure
RestartSec=2s

# --- sandbox (the agents' is omp-child@.service) ---
# See that file for the bwrap-to-systemd mapping and the user-namespace requirement. The sidecar runs a few things
# itself (terminal panel, git, the shell fallback of /session/:id/shell), so it stays sandboxed, but note that it
# can reach the user manager (below) and so is not a boundary against itself.
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
NoNewPrivileges=yes
BindPaths=/opt/rocm %h/.config/openchamber /hdd/brute/projects -%h/git %h/.omp %h/.pi %h/.paseo %h/.cache %h/.cargo %h/.rustup
BindReadOnlyPaths=%h/bin %h/.bun %h/.gitconfig %h/.gitignore %h/.zshrc

# The sidecar starts the children and watches them (systemctl --user), so it, and only it,
# can reach the user manager: the bus for systemd-run and other clients, the manager's private socket for systemctl (which does not
# fall back to the bus). That is a sandbox escape by design: whoever can talk to either can start a unit outside
# the sandbox. The agents the children run cannot: their drop-in binds neither.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
BindPaths=%t/bus %t/systemd/private
